/* 合成大染缸 · 落球合成（无限模式）视觉，对齐 合成大染缸版本2.html */
.viewport {
  position: relative; width: 100vw; height: 100vh; overflow: hidden;
}
.merge-back-shell {
  position: fixed;
  z-index: 95;
  left: 22rpx;
  top: max(calc(env(safe-area-inset-top) + 12rpx), 74rpx);
}
.mergeBack {
  position: fixed;
  z-index: 95;
  left: 22rpx;
  top: max(calc(env(safe-area-inset-top) + 12rpx), 74rpx);
  min-width: 112rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 20rpx 3rpx 13rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #24488f;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  background: rgba(255,255,255,.92);
  border: 1rpx solid rgba(180,193,235,.72);
  box-shadow: 0 9rpx 24rpx rgba(42,60,126,.16), inset 0 2rpx 0 rgba(255,255,255,.98);
}
.mergeBack::after { border: 0; }
.mergeBack:active { transform: scale(.95); }
.mergeBackArrow { margin-top: -5rpx; font: 40rpx/1 Arial,sans-serif; }
.mergeBackText { white-space: nowrap; }
.page {
  position: relative;
  width: 947px;
  height: 2048px;
  transform-origin: 0 0;
  overflow: hidden;
  background: linear-gradient(180deg, #eaf0ff 0%, #dfe7ff 40%, #e9ecff 100%);
}
.pageBg {
  position: absolute; left: 0; top: 0; width: 947px; height: 2048px; z-index: 0;
}

/* 得分云 */
.scoreCloudBg {
  position: absolute; left: 25px; top: 70px; width: 300px; height: 170px; z-index: 2;
}
.scoreLabel {
  position: absolute; left: 25px; top: 101px; width: 245px; z-index: 3;
  font-family: "Songti SC","STSong","SimSun",serif; font-size: 24px; line-height: 1;
  color: #5267d0; letter-spacing: 3px; text-align: center;
}
.scoreValue {
  position: absolute; left: 25px; top: 137px; width: 245px; z-index: 3;
  font-family: Georgia,"Times New Roman",serif; font-size: 62px; line-height: 1;
  color: #0e43a2; letter-spacing: 1px; text-align: center;
  text-shadow: 0 1px 0 rgba(255,255,255,.45);
}
.goldStar {
  position: absolute; left: 314px; top: 78px; z-index: 3;
  font-size: 52px; color: #d9b86d; text-shadow: 0 0 10px rgba(222,190,113,.22);
}
.scoreGoal {
  position: absolute; left: 93px; top: 205px; z-index: 4;
  font-size: 17px; letter-spacing: 1px; color: #7b83bd;
  background: rgba(255,255,255,.62); border: 1px solid rgba(117,124,210,.12);
  border-radius: 16px; padding: 5px 12px;
}
.rewardHint {
  position: absolute; left: 91px; top: 238px; z-index: 4;
  font-size: 16px; letter-spacing: .5px; color: #7781bd;
  background: rgba(255,255,255,.58); border: 1px solid rgba(113,122,207,.10);
  border-radius: 14px; padding: 4px 10px;
}
.musicBtn {
  position: absolute; right: 240px; top: 111px; width: 72px; height: 72px; z-index: 8;
  border-radius: 50%; background: rgba(255,255,255,.9);
  box-shadow: 0 8px 18px rgba(59,75,160,.16), inset 0 0 0 1px rgba(219,225,250,.86);
  display: flex; align-items: center; justify-content: center;
}
.musicBtnIcon { width: 42px; height: 42px; }

/* 标题 */
.title {
  position: absolute; left: 0; top: 222px; width: 100%; z-index: 3;
  text-align: center; font-family: "Songti SC","STSong","SimSun",serif;
  font-size: 60px; font-weight: 700; letter-spacing: 4px; color: #174ca7;
}
.titleLine {
  position: absolute; left: 319px; top: 316px; width: 309px; height: 2px; z-index: 3;
  background: linear-gradient(90deg, transparent, #b8c5ef 18%, #b8c5ef 82%, transparent);
}
.titleFlower {
  position: absolute; left: 451px; top: 300px; width: 45px; height: 45px; z-index: 4;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  color: #8e91ef; font-size: 34px; background: rgba(255,255,255,.5);
}

/* 下一个 */
.nextLabel {
  position: absolute; left: 44px; top: 306px; z-index: 4;
  font-size: 31px; color: #1a56c3; font-weight: 700; letter-spacing: 1px;
}
.nextPiece {
  position: absolute; left: 153px; top: 263px; width: 134px; height: 134px; z-index: 4;
  border-radius: 50%; background: rgba(241,244,255,.9);
  box-shadow: 0 8px 20px rgba(62,78,164,.16); overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.nextPieceImg { width: 134px; height: 134px; }

/* 游戏区 */
.gameShell {
  position: absolute; left: 31px; top: 392px; width: 885px; height: 1020px; z-index: 2;
  overflow: visible;
}
.gameShellBg {
  position: absolute; left: 0; top: 0; width: 885px; height: 1020px; z-index: 1;
}
.playCanvas {
  position: absolute; z-index: 20;
}
.gameOver {
  position: absolute; left: 0; top: 0; width: 885px; height: 1020px; z-index: 60;
  display: none; align-items: center; justify-content: center;
  background: rgba(20,38,88,.28); backdrop-filter: blur(5px);
}
.gameOver.show { display: flex; }
.overCard {
  width: 520px; padding: 38px 42px 34px; border-radius: 34px; text-align: center;
  background: rgba(255,255,255,.97); border: 1px solid rgba(100,114,210,.14);
  box-shadow: 0 26px 60px rgba(36,55,126,.25);
}
.overTitle {
  font-family: "Songti SC","STSong","SimSun",serif; font-size: 34px; font-weight: 700;
  color: #1c3f86; letter-spacing: 2px;
}
.overText {
  margin-top: 14px; font-size: 21px; color: #5a648f; line-height: 1.5;
}
.restart {
  margin-top: 25px; width: 250px; height: 66px; border-radius: 33px;
  color: #fff; background: linear-gradient(135deg,#5368e7,#8570ef);
  font-size: 23px; font-weight: 700; display: flex; align-items: center; justify-content: center;
  margin-left: auto; margin-right: auto;
}

/* 规则卡 */
.ruleCard {
  position: absolute; left: 35px; top: 1400px; width: 875px; height: 418px; z-index: 4;
}

/* 控制栏 */
.controls {
  position: absolute; left: 55px; right: 55px; bottom: 74px; height: 101px; z-index: 5;
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 65px;
}
.ctrl {
  position: relative; width: auto; height: 101px;
  border: 1px solid rgba(196,203,252,.82); border-radius: 51px;
  background: radial-gradient(150px 58px at 50% 100%, rgba(107,107,255,.17), transparent 72%),
              linear-gradient(180deg, rgba(255,255,255,.98), rgba(247,248,255,.98));
  box-shadow: 0 12px 20px rgba(86,87,213,.18), inset 0 0 22px rgba(123,136,255,.10), inset 0 1px 0 rgba(255,255,255,1);
  color: #5065df; font-family: "Songti SC","STSong","SimSun",serif; font-size: 28px; font-weight: 700;
  display: flex; align-items: center; justify-content: center; gap: 10px;
}
.ctrlIcon { width: 44px; height: 44px; }
.ctrlLabel { font-size: 26px; letter-spacing: 1px; }
.badge {
  position: absolute; right: -1px; top: -21px; width: 58px; height: 36px; border-radius: 18px;
  background: linear-gradient(135deg,#6978f5,#7180ee); color: #fff;
  font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; font-size: 22px; font-weight: 500;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 5px 10px rgba(74,82,210,.20);
}

/* 纹样奖励弹窗 */
.rewardModalMask {
  position: absolute; left: 0; top: 0; width: 947px; height: 2048px; z-index: 70;
  display: none; align-items: center; justify-content: center;
  background: rgba(28,47,98,.22); backdrop-filter: blur(7px);
}
.rewardModalMask.show { display: flex; }
.rewardModalCard {
  position: relative; width: 600px; min-height: 500px; max-height: 760px; padding: 46px 48px 40px; border-radius: 42px;
  text-align: center; display: flex; flex-direction: column; align-items: center;
  background: radial-gradient(240px 180px at 50% 24%, rgba(224,227,255,.78), transparent 72%),
              rgba(255,255,255,.975);
  border: 1px solid rgba(100,115,210,.14); box-shadow: 0 30px 70px rgba(36,55,126,.25);
}
.rewardBadge {
  display: inline-flex; height: 38px; align-items: center; padding: 0 18px; border-radius: 20px;
  background: #eef0ff; color: #7179cf; font-size: 18px; letter-spacing: 2px;
}
.rewardCongrats {
  margin-top: 14px; color: #213f83; font-family: "Songti SC","STSong","SimSun",serif;
  font-size: 29px; font-weight: 700; letter-spacing: 3px;
}
.rewardBundleTitle {
  margin-top: 15px; color: #274889; font-family: "Songti SC","STSong","SimSun",serif;
  font-size: 30px; font-weight: 700; letter-spacing: 2px;
}
.rewardGrid {
  margin: 24px auto 8px; width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18px;
}
.rewardGrid.single { grid-template-columns: minmax(0,1fr); max-width: 260px; }
.rewardGrid.many { grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; }
.rewardItem {
  min-height: 154px; padding: 15px 10px 13px; border-radius: 24px;
  background: linear-gradient(180deg, rgba(246,247,255,.98), rgba(252,252,255,.98));
  border: 1px solid rgba(108,119,210,.12); box-shadow: 0 7px 16px rgba(48,66,145,.08);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.rewardPatternImg { width: 88px; height: 88px; border-radius: 50%; border: 4px solid rgba(255,255,255,.88);
  box-shadow: 0 4px 11px rgba(43,67,145,.18); }
.rewardGrid.single .rewardPatternImg { width: 126px; height: 126px; }
.rewardItemName { margin-top: 10px; color: #2e4f96; font-size: 18px; font-weight: 700; line-height: 1.35; }
.rewardItemSource { margin-top: 4px; color: #959db7; font-size: 14px; line-height: 1.3; }
.rewardThreshold { margin-top: 10px; font-size: 18px; color: #949db8; }
.rewardCollect {
  margin-top: 30px; width: 330px; height: 70px; border-radius: 35px; color: #fff;
  font-size: 23px; font-weight: 700; letter-spacing: 1px;
  background: linear-gradient(135deg,#5168e7,#8270ef); box-shadow: 0 10px 22px rgba(74,80,210,.22);
  display: flex; align-items: center; justify-content: center;
}

/* 轻提示 */
.toast {
  position: absolute; left: 50%; bottom: 180px; transform: translateX(-50%) translateY(12px);
  padding: 15px 28px; border-radius: 28px; background: rgba(31,48,98,.92); color: #fff;
  font-size: 22px; opacity: 0; transition: .2s; z-index: 30; white-space: nowrap;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
