.works-page {
  min-height: 100vh;
  padding: 40rpx 28rpx 60rpx;
  box-sizing: border-box;
}
.works-head { margin-bottom: 24rpx; }
.works-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 44rpx;
  font-weight: 700;
  color: #173d79;
}
.works-sub { font-size: 24rpx; color: #4f5f7a; margin-top: 8rpx; }

/* 筛选 */
.filter-bar { white-space: nowrap; margin-bottom: 24rpx; }
.filter-chip {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 16rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #2a44c1;
  box-shadow: inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
}
.filter-chip.active {
  background: linear-gradient(90deg, #347af0, #5d78fd 42%, #a160ef);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(101,124,253,0.28), inset 0 1rpx 0 rgba(255,255,255,0.5);
}

.hint, .empty { text-align: center; color: #8b97b3; padding: 80rpx 0; }
.empty-emoji { font-size: 72rpx; }
.empty-text { margin: 20rpx 0 30rpx; }
.empty-btn { width: 60%; margin: 0 auto; }

/* 作品卡 */
.work-list { display: flex; flex-direction: column; gap: 22rpx; }
.work-card {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(18px) saturate(170%);
  backdrop-filter: blur(18px) saturate(170%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.16), inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
  overflow: hidden;
}
.work-img {
  width: 170rpx;
  height: 170rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.work-body { flex: 1; min-width: 0; }
.work-name { font-size: 30rpx; font-weight: 600; color: #173d79; }
.work-meta { font-size: 22rpx; color: #8b97b3; margin: 6rpx 0 10rpx; }
.work-story {
  font-size: 23rpx;
  color: #4f5f7a;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.work-note {
  font-size: 23rpx;
  color: #2a44c1;
  font-style: italic;
  margin-top: 8rpx;
}
.work-actions { margin-top: 14rpx; display: flex; gap: 32rpx; }
.work-link { font-size: 25rpx; color: #2a44c1; }

/* 商城 */
.mall-block {
  margin-top: 36rpx;
  padding: 32rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(18px) saturate(170%);
  backdrop-filter: blur(18px) saturate(170%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 31rpx;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.16), inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
}
.mall-title { font-size: 30rpx; font-weight: 700; color: #173d79; }
.mall-desc { font-size: 24rpx; color: #4f5f7a; line-height: 1.6; margin: 12rpx 0 24rpx; }
.mall-actions { display: flex; gap: 20rpx; }
.mall-btn { flex: 1; }

.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 320px;
  height: 420px;
}
