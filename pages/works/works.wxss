.works-page {
  position: relative;
  min-height: 100vh;
  padding: 0 28rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}
.status-spacer { height: calc(env(safe-area-inset-top) + 88rpx); }
.works-ink { position: fixed; z-index: 1; pointer-events: none; border-radius: 50%; filter: blur(12rpx); }
.works-ink-top { width: 470rpx; height: 330rpx; left: -210rpx; top: -90rpx; background: radial-gradient(ellipse, rgba(63,134,225,.26), rgba(123,102,224,.08) 55%, transparent 75%); }
.works-ink-right { width: 450rpx; height: 650rpx; right: -280rpx; top: 150rpx; background: radial-gradient(ellipse, rgba(117,95,211,.20), rgba(69,131,222,.08) 58%, transparent 76%); }
.works-head { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; }
.works-title { font-family: "Songti SC", "STSong", serif; font-size: 55rpx; font-weight: 700; letter-spacing: 4rpx; color: #113e79; }
.works-title-spark { margin-left: 8rpx; color: #6972dc; font-size: 27rpx; vertical-align: top; }
.head-create { width: 72rpx; height: 72rpx; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.55); border: 1.5rpx solid rgba(255,255,255,.88); color: #244f8f; font-size: 45rpx; font-weight: 300; box-shadow: 0 10rpx 26rpx rgba(34,61,111,.13), inset 0 1rpx 0 rgba(255,255,255,.95); }
.head-create::after, .work-action::after, .state-btn::after, .create-first::after, .mall-btn::after { border: none; }
.profile-row { position: relative; z-index: 2; display: flex; align-items: center; margin: 34rpx 0 30rpx; }
.profile-avatar { width: 102rpx; height: 102rpx; flex: 0 0 auto; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: "Songti SC", "STSong", serif; font-size: 46rpx; color: #17447f; background: radial-gradient(circle at 35% 30%, rgba(255,255,255,.92), rgba(107,159,228,.24) 55%, rgba(118,91,215,.18)); border: 2rpx solid rgba(255,255,255,.85); box-shadow: 0 10rpx 25rpx rgba(53,74,122,.13); }
.profile-copy { margin-left: 24rpx; }
.profile-name { font-size: 33rpx; font-weight: 700; color: #183f77; }
.profile-meta { margin-top: 8rpx; font-size: 23rpx; color: #74819b; }
.filter-bar { position: relative; z-index: 2; width: 100%; white-space: nowrap; margin-bottom: 26rpx; }
.filter-inner { display: inline-flex; padding: 2rpx 0 8rpx; }
.filter-chip { flex: 0 0 auto; min-width: 112rpx; height: 60rpx; margin-right: 14rpx; padding: 0 25rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 999rpx; font-size: 25rpx; color: #53617b; background: rgba(255,255,255,.43); border: 1.2rpx solid rgba(56,75,119,.13); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.92); }
.filter-chip.active { color: #fff; background: linear-gradient(90deg, #244fa9, #4657c7 55%, #7259d1); border-color: transparent; box-shadow: 0 8rpx 20rpx rgba(61,76,184,.24), inset 0 1rpx 0 rgba(255,255,255,.45); }
.liquid-glass-card { background: rgba(255,255,255,.48); border: 1.5rpx solid rgba(255,255,255,.88); box-shadow: 0 17rpx 45rpx rgba(39,57,102,.13), inset 0 1.5rpx 0 rgba(255,255,255,.96), inset 0 -1.5rpx 2rpx rgba(31,49,90,.07); -webkit-backdrop-filter: blur(18px) saturate(170%); backdrop-filter: blur(18px) saturate(170%); }
.state-card, .empty-card { position: relative; z-index: 2; margin-top: 30rpx; padding: 70rpx 45rpx; border-radius: 34rpx; text-align: center; }
.state-icon { font-family: Georgia, serif; font-size: 68rpx; color: #5361c5; }
.state-title { margin-top: 13rpx; font-family: "Songti SC", "STSong", serif; font-size: 31rpx; font-weight: 700; color: #173f79; }
.state-desc { margin: 15rpx auto 0; max-width: 530rpx; font-size: 23rpx; line-height: 1.6; color: #75819a; }
.state-btn { width: 250rpx; height: 70rpx; margin-top: 25rpx; border-radius: 999rpx; background: rgba(75,83,192,.10); border: 1rpx solid rgba(70,78,181,.20); color: #4053ae; font-size: 25rpx; }
.loading-orb { width: 56rpx; height: 56rpx; margin: 0 auto; border-radius: 50%; border: 5rpx solid rgba(74,85,196,.15); border-top-color: #5361c5; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.empty-art { position: relative; width: 220rpx; height: 220rpx; margin: -12rpx auto 20rpx; border-radius: 50%; border: 1rpx dotted rgba(62,85,170,.35); }
.empty-art-image { width: 180rpx; height: 180rpx; margin: 20rpx; border-radius: 50%; opacity: .78; }
.create-first { width: 360rpx; height: 82rpx; margin-top: 30rpx; border-radius: 999rpx; color: #fff; font-size: 27rpx; background: linear-gradient(90deg, #214ca3, #4654c3 55%, #7259d1); box-shadow: 0 10rpx 25rpx rgba(60,72,172,.25); }
.work-grid { position: relative; z-index: 2; display: flex; flex-wrap: wrap; align-items: flex-start; margin: 0 -9rpx; }
.work-card { width: calc(50% - 18rpx); margin: 0 9rpx 22rpx; border-radius: 30rpx; overflow: hidden; box-sizing: border-box; }
.work-img { display: block; width: calc(100% - 18rpx); height: 292rpx; margin: 9rpx; border-radius: 23rpx; background: #eef1f8; }
.work-body { padding: 14rpx 18rpx 18rpx; }
.work-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 700; color: #173f79; }
.work-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.work-date { font-family: Georgia, serif; font-size: 21rpx; color: #7b86a1; }
.work-status { flex: 0 0 auto; padding: 5rpx 16rpx; border-radius: 999rpx; border: 1rpx solid rgba(87,81,195,.20); background: rgba(94,82,204,.07); color: #5d55b8; font-size: 19rpx; }
.work-status.making { color: #fff; background: linear-gradient(90deg,#2b4da9,#6258ce); border-color: transparent; }
.work-note { margin-top: 11rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: "Songti SC", "STSong", serif; font-size: 21rpx; color: #66738e; }
.work-actions { display: flex; flex-wrap: wrap; margin: 13rpx -3rpx -4rpx; }
.work-action { flex: 1 0 44%; min-width: 0; height: 64rpx; margin: 4rpx 3rpx; padding: 0 5rpx; border-radius: 999rpx; background: rgba(74,87,190,.07); color: #4a57a6; font-size: 26rpx; font-weight: 600; line-height: 64rpx; }
.work-action.primary { flex-basis: 100%; color: #fff; background: linear-gradient(90deg,#294fa9,#6357cc); }
.mall-block { position: relative; z-index: 2; margin-top: 22rpx; padding: 36rpx 32rpx; border-radius: 32rpx; overflow: hidden; }
.mall-block::after { content: ""; position: absolute; width: 300rpx; height: 300rpx; right: -145rpx; bottom: -160rpx; border-radius: 50%; background: radial-gradient(circle, rgba(80,118,222,.25), transparent 68%); }
.mall-kicker { position: relative; z-index: 2; font-size: 21rpx; letter-spacing: 2rpx; color: #6c75a0; }
.mall-title { position: relative; z-index: 2; margin-top: 8rpx; font-family: "Songti SC", "STSong", serif; font-size: 34rpx; font-weight: 700; color: #173f79; }
.mall-desc { position: relative; z-index: 2; margin-top: 13rpx; max-width: 570rpx; font-size: 23rpx; line-height: 1.62; color: #697791; }
.mall-actions { position: relative; z-index: 2; display: flex; margin-top: 24rpx; }
.mall-btn { flex: 1; height: 72rpx; border-radius: 999rpx; font-size: 24rpx; }
.mall-btn + .mall-btn { margin-left: 15rpx; }
.mall-btn-primary { color: #fff; background: linear-gradient(90deg,#244fa9,#6658d0); }
.mall-btn-secondary { color: #3c4f9e; background: rgba(81,88,194,.08); border: 1rpx solid rgba(68,77,177,.20); }
.share-canvas { position: fixed; left: -9999rpx; top: -9999rpx; width: 320px; height: 420px; }
