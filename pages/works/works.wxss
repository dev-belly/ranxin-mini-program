/* 归属：A｜产品前端 Owner */
.page { padding: 32rpx 32rpx 60rpx; }
.section-title { font-size: 34rpx; font-weight: 600; color: #1f2a3a; margin-bottom: 24rpx; }
.hint, .empty { text-align: center; color: #8a93a6; font-size: 28rpx; padding: 80rpx 0; }
.empty-emoji { font-size: 72rpx; margin-bottom: 16rpx; }
.empty-text { line-height: 1.6; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.work {
  width: 48%;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(31, 42, 58, 0.06);
}
.work-img { width: 100%; height: 300rpx; display: block; background: #f3f6fb; }
.work-name { padding: 16rpx 20rpx 0; font-size: 28rpx; font-weight: 600; color: #1f2a3a; }
.work-meta { padding: 6rpx 20rpx 20rpx; font-size: 22rpx; color: #8a93a6; }
