/* 归属：A｜产品前端 Owner · rx 水彩主题统一 */
.page {
  padding: 32rpx 32rpx 60rpx;
  background: transparent;
}
.section-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a2b4d;
  margin-bottom: 8rpx;
  font-family: "Songti SC", "STSong", serif;
  letter-spacing: 4rpx;
}
.section-sub {
  display: block;
  font-size: 26rpx;
  color: #6b7790;
  margin-bottom: 28rpx;
}
.hint, .empty {
  text-align: center;
  color: #8a93a6;
  font-size: 28rpx;
  padding: 80rpx 0;
}
.empty-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.empty-text {
  line-height: 1.6;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.work {
  width: 48%;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 22rpx rgba(47, 68, 130, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.work-img {
  width: 100%;
  height: 300rpx;
  display: block;
  background: rgba(75, 110, 230, 0.08);
}
.work-name {
  padding: 16rpx 20rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2b4d;
}
.work-meta {
  padding: 6rpx 20rpx 20rpx;
  font-size: 22rpx;
  color: #6b7790;
}

.create-bar {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}
.create-btn {
  background: linear-gradient(135deg, #4b6ee6 0%, #7b5fe0 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 22rpx 56rpx;
  box-shadow: 0 10rpx 24rpx rgba(93, 95, 220, 0.25);
}
.create-btn::after { border: none; }
