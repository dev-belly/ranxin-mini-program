<!-- 归属：A｜产品前端 Owner（B 按 1首页.html 重制） -->
<view class="rx-bg"></view>
<view class="rx-page home">

  <!-- 顶部 logo + 音乐 -->
  <view class="home-header">
    <view class="home-brand">
      <text class="home-title">染心</text>
      <text class="home-tag">白族扎染 · 把情绪染成纹样</text>
    </view>
    <view class="music-btn {{musicOn ? 'on' : ''}}" bindtap="toggleMusic">
      <text class="music-icon">♪</text>
    </view>
  </view>

  <!-- 情绪问题 + 胶囊 -->
  <view class="question">今天，你想把什么情绪染开？<text class="spark">✦</text></view>
  <view class="chips">
    <view
      wx:for="{{emotions}}"
      wx:key="key"
      class="chip {{item.active ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="selectEmotion"
    >{{item.label}}</view>
  </view>

  <!-- hero 卡：灵魂扎染测试（对齐 A 深蓝渐变） -->
  <view class="card hero" bindtap="goMbti">
    <image class="card-img" src="/assets/patterns/tuan.png" mode="aspectFill" />
    <view class="hero-copy">
      <view class="eyebrow">灵魂扎染</view>
      <view class="hero-h2">测测你的</view>
      <view class="hero-h2">灵魂扎染纹样</view>
      <view class="hero-p">30 道情境题，找到属于你的白族扎染纹样</view>
      <view class="glow-btn">开始测试 ›</view>
    </view>
  </view>

  <!-- stress 卡：放松一下（对齐 A 稿） -->
  <view class="card stress" bindtap="goRelax">
    <image class="card-img" src="/assets/patterns/cang.png" mode="aspectFill" />
    <view class="stress-copy">
      <view class="stress-h2">放松一下</view>
      <view class="stress-desc">呼吸、染色、等待——把心事慢慢浸开</view>
      <view class="relax-meta">
        <text class="stag">已坚持 {{relaxDays}} 天</text>
        <text class="stag" wx:if="{{relaxCount > 0}}">今日 {{relaxCount}} 次</text>
      </view>
      <view class="white-btn" catchtap="goRelax">立即放松 ›</view>
    </view>
  </view>

  <!-- 一分钟非遗 -->
  <view class="heritage-head">
    <view class="heritage-title">一分钟非遗</view>
    <view class="heritage-more" bindtap="goKnowledge">更多知识 ›</view>
  </view>
  <view class="knowledge">
    <view
      wx:for="{{knowledge}}"
      wx:key="id"
      class="kcard"
      data-art="{{item.art}}"
      bindtap="goArticle"
    >
      <view class="kheader">
        <view class="khead-tag">{{item.tag}}</view>
        <view class="khead-title">{{item.title}}</view>
        <view class="klead">{{item.lead}}</view>
      </view>
      <view class="kart-zone"><image src="{{item.img}}" mode="aspectFill" /></view>
    </view>
  </view>

</view>
