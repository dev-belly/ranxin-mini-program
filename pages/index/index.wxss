/* 归属：A｜产品前端 Owner（B 按 1首页.html 重制） */

.home {
  padding-top: 24rpx;
}

/* 顶部 logo + 音乐（对齐 A .logo/.tagline/.music） */
.home-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 8rpx;
}
.home-brand {
  display: flex;
  flex-direction: column;
}
.home-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 72rpx;
  font-weight: 700;
  color: #173d79;
  letter-spacing: 8rpx;
  line-height: 1;
}
.home-tag {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7384a1;
  letter-spacing: 2rpx;
}
.music-btn {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(16px) saturate(190%);
  backdrop-filter: blur(16px) saturate(190%);
  border: 1.5rpx solid var(--glass-border-bright);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 4rpx rgba(126, 118, 242, .14), 0 0 30rpx rgba(112, 104, 237, .30), 0 8rpx 20rpx rgba(40, 67, 124, .12), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.music-btn.on {
  box-shadow: 0 0 0 4rpx rgba(126, 118, 242, .22), 0 0 34rpx rgba(112, 104, 237, .42), 0 8rpx 18rpx rgba(40, 67, 124, .10);
}
.music-icon {
  font-size: 36rpx;
  color: #173d79;
}

/* 情绪问题 + 胶囊（对齐 A .question/.chips/.chip） */
.question {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #173d79;
  margin-top: 8rpx;
}
.question .spark {
  font-family: Arial;
  color: #a8cdef;
  margin-left: 8rpx;
  font-size: 26rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.chip {
  height: 69rpx;
  min-width: 144rpx;
  margin-right: 22rpx;
  margin-bottom: 18rpx;
  padding: 0 28rpx;
  border-radius: 35rpx;
  position: relative;
  border: 1.5rpx solid var(--glass-border);
  background: var(--glass-sheen), var(--glass-bg);
  -webkit-backdrop-filter: blur(16px) saturate(190%);
  backdrop-filter: blur(16px) saturate(190%);
  color: #4f5f7a;
  font-size: 27rpx;
  letter-spacing: 2rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--glass-shadow), var(--glass-thickness);
}
.chip.active {
  color: #fff;
  border-color: transparent;
  background: linear-gradient(90deg, #347af0 0%, #5d78fd 42%, #a160ef 100%);
  box-shadow: 0 0 0 5rpx rgba(101, 124, 253, .10), 0 0 24rpx rgba(95, 90, 255, .44), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.6), inset 0 -1.5rpx 1rpx rgba(20, 30, 70, 0.20);
}

/* 通用大卡片（对齐 A .card） */
.card {
  position: relative;
  margin-top: 28rpx;
  border-radius: 31rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 28rpx rgba(24, 48, 89, .10);
}
.card-img {
  position: absolute;
  right: 0;
  top: 0;
  width: 320rpx;
  height: 100%;
  object-fit: cover;
  object-position: right center;
  z-index: 1;
}

/* hero 卡：灵魂扎染测试（对齐 A 深蓝渐变 #082d6d→#184988） */
.hero {
  position: relative;
  min-height: 300rpx;
  background:
    var(--glass-sheen),
    linear-gradient(90deg, rgba(8, 45, 109, .56), rgba(10, 50, 119, .48), rgba(24, 73, 136, .56));
  -webkit-backdrop-filter: blur(26px) saturate(180%) brightness(110%);
  backdrop-filter: blur(26px) saturate(180%) brightness(110%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 31rpx;
  box-shadow: 0 18rpx 56rpx rgba(8, 30, 80, 0.32), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.45), inset 0 -1.5rpx 1rpx rgba(0, 10, 40, 0.30);
}
.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 1.4rpx rgba(255, 255, 255, 0.42);
}
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(90deg, rgba(7, 29, 71, .55) 0%, rgba(7, 29, 71, .42) 40%, rgba(7, 29, 71, .10) 60%, transparent 82%);
}
.hero-copy {
  position: relative;
  z-index: 3;
  padding: 40rpx 36rpx;
  color: #fff;
}
.eyebrow {
  display: inline-flex;
  align-items: center;
  height: 46rpx;
  padding: 0 17rpx;
  border-radius: 23rpx;
  border: 1.3rpx solid rgba(255, 255, 255, .45);
  font-size: 23rpx;
  color: rgba(255, 255, 255, .86);
}
.hero-h2 {
  font-size: 52rpx;
  line-height: 1.4;
  font-weight: 500;
  letter-spacing: 3rpx;
  margin: 24rpx 0 12rpx;
}
.hero-p {
  font-size: 24rpx;
  letter-spacing: 1.7rpx;
  color: rgba(255, 255, 255, .74);
  margin: 0;
}
.glow-btn {
  position: relative;
  margin-top: 32rpx;
  display: inline-flex;
  align-items: center;
  height: 74rpx;
  padding: 0 34rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 38rpx;
  color: #fff;
  font-size: 29rpx;
  letter-spacing: 3rpx;
  background: linear-gradient(90deg, rgba(104, 167, 255, .94), rgba(121, 130, 255, .94), rgba(181, 108, 232, .94));
  -webkit-backdrop-filter: blur(12px) saturate(160%);
  backdrop-filter: blur(12px) saturate(160%);
  box-shadow: 0 12rpx 30rpx rgba(124, 145, 255, .40), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.6), inset 0 -1.5rpx 1rpx rgba(20, 30, 70, 0.18);
  overflow: hidden;
}
.glow-btn::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 42%);
  pointer-events: none;
}

/* stress 卡：放松一下（对齐 A 蓝渐变） */
.stress {
  position: relative;
  min-height: 240rpx;
  background:
    var(--glass-sheen),
    linear-gradient(135deg, rgba(52, 122, 240, .14), rgba(161, 96, 239, .12)), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(22px) saturate(200%);
  backdrop-filter: blur(22px) saturate(200%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 31rpx;
  box-shadow: 0 16rpx 50rpx rgba(31, 45, 90, 0.18), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.stress::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 1.4rpx rgba(255, 255, 255, 0.42);
}
.stress::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(90deg, rgba(47, 91, 154, .18) 0%, rgba(61, 100, 160, .10) 40%, transparent 70%);
}
.stress-copy {
  position: relative;
  z-index: 3;
  padding: 36rpx;
  color: #fff;
}
.stress-h2 {
  font-size: 50rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
}
.stress-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, .85);
}
.relax-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.stag {
  display: inline-flex;
  align-items: center;
  height: 43rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  border: 1.2rpx solid rgba(255, 255, 255, .42);
  font-size: 20rpx;
  color: rgba(255, 255, 255, .82);
  letter-spacing: 2rpx;
}
.score {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}
.score-label,
.score-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, .8);
}
.score-num {
  font-size: 48rpx;
  font-weight: 400;
  letter-spacing: 5rpx;
  color: #ddd7ff;
  margin: 0 12rpx;
}
.white-btn {
  position: relative;
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  height: 65rpx;
  padding: 0 35rpx;
  border-radius: 33rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(14px) saturate(180%);
  backdrop-filter: blur(14px) saturate(180%);
  border: 1.5rpx solid var(--glass-border-bright);
  color: #2d5a9c;
  font-size: 28rpx;
  letter-spacing: 3rpx;
  box-shadow: 0 8rpx 22rpx rgba(26, 52, 96, .12), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}

/* DIY 卡：正念 DIY（首页蓝紫调入口，点击跳正念 DIY tab） */
.diy-entry {
  position: relative;
  min-height: 240rpx;
  background:
    var(--glass-sheen),
    linear-gradient(135deg, rgba(125, 107, 255, .22), rgba(52, 122, 240, .16)), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(22px) saturate(200%);
  backdrop-filter: blur(22px) saturate(200%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 31rpx;
  box-shadow: 0 16rpx 50rpx rgba(31, 45, 90, 0.18), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.diy-entry::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 1.4rpx rgba(255, 255, 255, 0.42);
}
.diy-entry::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(90deg, rgba(52, 80, 150, .20) 0%, rgba(95, 90, 180, .12) 40%, transparent 70%);
}
.diy-copy {
  position: relative;
  z-index: 3;
  padding: 36rpx;
  color: #fff;
}
.diy-h2 {
  font-size: 50rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
}
.diy-p {
  margin-top: 12rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, .85);
}

/* 今日染力榜（对齐 A image1） */
.leaderboard {
  position: relative; margin-top: 28rpx; padding: 30rpx;
  background: var(--glass-sheen), var(--glass-bg-strong); border: 1rpx solid var(--glass-border);
  border-radius: 32rpx; box-shadow: var(--glass-shadow), var(--glass-thickness);
  overflow: hidden;
}
.leaderboard::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(120% 120% at 50% 0%, rgba(255, 255, 255, 0.22), transparent 42%),
    radial-gradient(120% 120% at 50% 100%, rgba(255, 255, 255, 0.12), transparent 42%);
  box-shadow: var(--glass-edge);
}
.lb-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; position: relative; z-index: 1; }
.lb-title { font-size: 34rpx; font-weight: 700; color: #173d79; letter-spacing: 2rpx; }
.lb-tabs { display: flex; gap: 10rpx; position: relative; z-index: 1; }
.lb-tab { padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 24rpx; color: #5d7099; }
.lb-tab.active { background: #173d79; color: #fff; }
.lb-list { position: relative; z-index: 1; }
.lb-row { display: flex; align-items: center; gap: 18rpx; padding: 14rpx 0; border-bottom: 1rpx solid rgba(23, 61, 121, .08); }
.lb-row:last-child { border-bottom: 0; }
.lb-rank {
  width: 44rpx; height: 44rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: #5d7099; background: rgba(23,61,121,.08);
}
.lb-rank.gold { background: linear-gradient(135deg,#ffd24c,#ffb347); color: #fff; }
.lb-rank.silver { background: linear-gradient(135deg,#e8e8e8,#c8c8c8); color: #fff; }
.lb-rank.copper { background: linear-gradient(135deg,#f5b78c,#e08e66); color: #fff; }
.lb-avatar { width: 60rpx; height: 60rpx; border-radius: 50%; border: 2rpx solid rgba(255,255,255,.35); }
.lb-name { flex: 1; font-size: 26rpx; color: #173d79; }
.lb-score { font-size: 26rpx; font-weight: 700; color: #2a44c1; }
.lb-more { margin-top: 8rpx; font-size: 24rpx; color: #5d7099; position: relative; z-index: 1; }

/* 一分钟非遗（对齐 A .heritage-head/.knowledge/.kcard） */
.heritage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 52rpx;
  margin-bottom: 22rpx;
}
.heritage-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #173d79;
}
.heritage-title::before {
  content: "✦";
  font-family: Arial;
  font-size: 24rpx;
  color: #6e86e8;
  margin-right: 8rpx;
}
.heritage-more {
  font-size: 24rpx;
  color: #687b9d;
}
.knowledge {
  display: flex;
  overflow-x: auto;
  padding-bottom: 8rpx;
}
.kcard {
  position: relative;
  flex: 0 0 64%;
  margin-right: 14rpx;
  overflow: hidden;
  border-radius: 28rpx;
  min-height: 300rpx;
  background:
    var(--glass-sheen),
    linear-gradient(135deg, rgba(255, 255, 255, 0.30), rgba(255, 255, 255, 0.08)), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(22px) saturate(200%);
  backdrop-filter: blur(22px) saturate(200%);
  border: 1.5rpx solid var(--glass-border-bright);
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.18), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.kcard::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 1.4rpx rgba(255, 255, 255, 0.42);
}
.kcard:last-child {
  margin-right: 0;
}
.kheader {
  position: absolute;
  left: 22rpx;
  right: 18rpx;
  top: 22rpx;
  z-index: 4;
}
.khead-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(52, 122, 240, .10);
  color: #2a44c1;
  font-size: 20rpx;
}
.khead-title {
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #173d79;
}
.klead {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #2d4e82;
}
.kart-zone {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 150rpx;
  overflow: hidden;
  z-index: 1;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.38));
}
.kart-zone image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 75%;
  height: 100%;
  object-fit: cover;
}
