/* 归属：A｜产品前端 Owner */
.page { padding: 0 32rpx 60rpx; }
.hero {
  margin-top: 40rpx;
  padding: 64rpx 40rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #2b4c7e 0%, #1e3a66 100%);
  color: #fff;
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(43, 76, 126, 0.25);
}
.brand { font-size: 72rpx; font-weight: 700; letter-spacing: 12rpx; }
.slogan { margin-top: 16rpx; font-size: 32rpx; opacity: 0.95; }
.hero-sub { margin-top: 12rpx; font-size: 24rpx; opacity: 0.75; }
.cta {
  margin-top: 40rpx;
  background: #fff;
  color: #2b4c7e;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 18rpx 0;
}
.section-title {
  margin: 48rpx 4rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a3a;
}
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.card {
  width: 48%;
  box-sizing: border-box;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(31, 42, 58, 0.06);
}
.card-name { font-size: 32rpx; font-weight: 600; color: #1f2a3a; }
.card-desc { margin-top: 10rpx; font-size: 24rpx; color: #8a93a6; line-height: 1.5; }
.foot {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #aeb6c6;
}
