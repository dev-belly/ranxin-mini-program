/* 归属：A｜产品前端 Owner（B 按 1首页.html 重制） */

.home {
  padding-top: 24rpx;
}

/* 顶部 logo + 音乐（对齐 A .logo/.tagline/.music） */
.home-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 8rpx;
}
.home-brand {
  display: flex;
  flex-direction: column;
}
.home-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 72rpx;
  font-weight: 700;
  color: #173d79;
  letter-spacing: 8rpx;
  line-height: 1;
}
.home-tag {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7384a1;
  letter-spacing: 2rpx;
}
.music-btn {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border: 1.5rpx solid rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 4rpx rgba(126, 118, 242, .16), 0 0 28rpx rgba(112, 104, 237, .25), 0 8rpx 18rpx rgba(40, 67, 124, .10), inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
.music-btn.on {
  box-shadow: 0 0 0 4rpx rgba(126, 118, 242, .22), 0 0 34rpx rgba(112, 104, 237, .42), 0 8rpx 18rpx rgba(40, 67, 124, .10);
}
.music-icon {
  font-size: 36rpx;
  color: #173d79;
}

/* 情绪问题 + 胶囊（对齐 A .question/.chips/.chip） */
.question {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #173d79;
  margin-top: 8rpx;
}
.question .spark {
  font-family: Arial;
  color: #a8cdef;
  margin-left: 8rpx;
  font-size: 26rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.chip {
  height: 69rpx;
  min-width: 144rpx;
  margin-right: 22rpx;
  margin-bottom: 18rpx;
  padding: 0 28rpx;
  border-radius: 35rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.5);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  color: #4f5f7a;
  font-size: 27rpx;
  letter-spacing: 2rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}
.chip.active {
  color: #fff;
  border-color: transparent;
  background: linear-gradient(90deg, #347af0 0%, #5d78fd 42%, #a160ef 100%);
  box-shadow: 0 0 0 5rpx rgba(101, 124, 253, .10), 0 0 24rpx rgba(95, 90, 255, .44), inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

/* 通用大卡片（对齐 A .card） */
.card {
  position: relative;
  margin-top: 28rpx;
  border-radius: 31rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 28rpx rgba(24, 48, 89, .10);
}
.card-img {
  position: absolute;
  right: 0;
  top: 0;
  width: 320rpx;
  height: 100%;
  object-fit: cover;
  object-position: right center;
  z-index: 1;
}

/* hero 卡：灵魂扎染测试（对齐 A 深蓝渐变 #082d6d→#184988） */
.hero {
  min-height: 300rpx;
  background: linear-gradient(90deg, rgba(8, 45, 109, .66), rgba(10, 50, 119, .58), rgba(24, 73, 136, .66));
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  backdrop-filter: blur(20px) saturate(160%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 31rpx;
  box-shadow: 0 16rpx 50rpx rgba(8, 30, 80, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(90deg, rgba(7, 29, 71, .55) 0%, rgba(7, 29, 71, .42) 40%, rgba(7, 29, 71, .10) 60%, transparent 82%);
}
.hero-copy {
  position: relative;
  z-index: 3;
  padding: 40rpx 36rpx;
  color: #fff;
}
.eyebrow {
  display: inline-flex;
  align-items: center;
  height: 46rpx;
  padding: 0 17rpx;
  border-radius: 23rpx;
  border: 1.3rpx solid rgba(255, 255, 255, .45);
  font-size: 23rpx;
  color: rgba(255, 255, 255, .86);
}
.hero-h2 {
  font-size: 52rpx;
  line-height: 1.4;
  font-weight: 500;
  letter-spacing: 3rpx;
  margin: 24rpx 0 12rpx;
}
.hero-p {
  font-size: 24rpx;
  letter-spacing: 1.7rpx;
  color: rgba(255, 255, 255, .74);
  margin: 0;
}
.glow-btn {
  margin-top: 32rpx;
  display: inline-flex;
  align-items: center;
  height: 74rpx;
  padding: 0 34rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 38rpx;
  color: #fff;
  font-size: 29rpx;
  letter-spacing: 3rpx;
  background: linear-gradient(90deg, rgba(104, 167, 255, .9), rgba(121, 130, 255, .9), rgba(181, 108, 232, .9));
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  box-shadow: 0 10rpx 26rpx rgba(124, 145, 255, .34), inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

/* stress 卡：放松一下（对齐 A 蓝渐变） */
.stress {
  min-height: 240rpx;
  background: linear-gradient(135deg, rgba(52, 122, 240, .16), rgba(161, 96, 239, .14)), rgba(255, 255, 255, 0.5);
  -webkit-backdrop-filter: blur(18px) saturate(170%);
  backdrop-filter: blur(18px) saturate(170%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 31rpx;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.16), inset 0 1.5rpx 0 rgba(255, 255, 255, 0.92);
}
.stress::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(90deg, rgba(47, 91, 154, .18) 0%, rgba(61, 100, 160, .10) 40%, transparent 70%);
}
.stress-copy {
  position: relative;
  z-index: 3;
  padding: 36rpx;
  color: #fff;
}
.stress-h2 {
  font-size: 50rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
}
.stress-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, .85);
}
.relax-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.stag {
  display: inline-flex;
  align-items: center;
  height: 43rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  border: 1.2rpx solid rgba(255, 255, 255, .42);
  font-size: 20rpx;
  color: rgba(255, 255, 255, .82);
  letter-spacing: 2rpx;
}
.score {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}
.score-label,
.score-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, .8);
}
.score-num {
  font-size: 48rpx;
  font-weight: 400;
  letter-spacing: 5rpx;
  color: #ddd7ff;
  margin: 0 12rpx;
}
.white-btn {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  height: 65rpx;
  padding: 0 35rpx;
  border-radius: 33rpx;
  background: rgba(255, 255, 255, 0.7);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border: 1.5rpx solid rgba(255, 255, 255, 0.72);
  color: #2d5a9c;
  font-size: 28rpx;
  letter-spacing: 3rpx;
  box-shadow: 0 8rpx 22rpx rgba(26, 52, 96, .12), inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

/* 一分钟非遗（对齐 A .heritage-head/.knowledge/.kcard） */
.heritage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 52rpx;
  margin-bottom: 22rpx;
}
.heritage-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #173d79;
}
.heritage-title::before {
  content: "✦";
  font-family: Arial;
  font-size: 24rpx;
  color: #6e86e8;
  margin-right: 8rpx;
}
.heritage-more {
  font-size: 24rpx;
  color: #687b9d;
}
.knowledge {
  display: flex;
  overflow-x: auto;
  padding-bottom: 8rpx;
}
.kcard {
  position: relative;
  flex: 0 0 64%;
  margin-right: 14rpx;
  overflow: hidden;
  border-radius: 28rpx;
  min-height: 300rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.10)), rgba(255, 255, 255, 0.5);
  -webkit-backdrop-filter: blur(20px) saturate(170%);
  backdrop-filter: blur(20px) saturate(170%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.16), inset 0 1.5rpx 0 rgba(255, 255, 255, 0.92);
}
.kcard:last-child {
  margin-right: 0;
}
.kheader {
  position: absolute;
  left: 22rpx;
  right: 18rpx;
  top: 22rpx;
  z-index: 4;
}
.khead-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(52, 122, 240, .10);
  color: #2a44c1;
  font-size: 20rpx;
}
.khead-title {
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #173d79;
}
.klead {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #2d4e82;
}
.kart-zone {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 150rpx;
  overflow: hidden;
  z-index: 1;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.38));
}
.kart-zone image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 75%;
  height: 100%;
  object-fit: cover;
}
