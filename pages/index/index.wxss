/* 归属：A｜产品前端 Owner（B 按设计稿 image1 重制） */

.home {
  padding-top: 32rpx;
}

/* 顶部标题区 */
.home-header {
  position: relative;
  text-align: center;
  padding: 24rpx 0 32rpx;
}
.home-brand {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}
.home-title {
  font-size: 76rpx;
  font-weight: 700;
  color: #1a2b4d;
  letter-spacing: 16rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  line-height: 1;
}
.home-tag {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6b7a9a;
  letter-spacing: 2rpx;
}
.music-btn {
  position: absolute;
  right: 0;
  top: 16rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 6rpx 16rpx rgba(47, 68, 130, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.music-icon {
  font-size: 32rpx;
  color: #4b6ee6;
}

/* 情绪选择 */
.emotion-section {
  margin-top: 12rpx;
}
.emotion-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2b4d;
  margin-bottom: 24rpx;
}
.emotion-chips {
  display: flex;
  flex-wrap: wrap;
}
.emotion-chip {
  margin-right: 18rpx;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  padding: 14rpx 28rpx;
}
.chip-star {
  font-size: 22rpx;
  margin-right: 8rpx;
}

/* 通用大卡片 */
.feature-card {
  position: relative;
  margin-top: 32rpx;
  border-radius: 36rpx;
  padding: 36rpx;
  min-height: 300rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(47, 68, 130, 0.14);
  background: linear-gradient(135deg, #4b6ee6 0%, #5c7ce8 45%, #7b5fe0 100%);
}
.feature-card::before {
  content: "";
  position: absolute;
  left: -40%;
  top: -40%;
  width: 140%;
  height: 140%;
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.25), transparent 55%);
  pointer-events: none;
}
.card-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 22rpx;
  margin-bottom: 18rpx;
}
.card-copy {
  position: relative;
  z-index: 2;
  max-width: 60%;
}
.card-headline {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.35;
}
.card-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}
.card-btn {
  margin-top: 26rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #4b6ee6;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

/* MBTI 卡片 */
.mbti-pattern {
  position: absolute;
  right: -40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  opacity: 0.85;
  box-shadow: 0 0 60rpx rgba(255, 255, 255, 0.35);
  z-index: 1;
}

/* 合成大染缸卡片 */
.game-card {
  background: linear-gradient(135deg, #5c7ce8 0%, #7b9bf5 50%, #9c8ff2 100%);
}
.game-header {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.game-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}
.game-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}
.game-tag-row {
  margin-top: 16rpx;
  display: flex;
}
.game-tag-row .rx-tag {
  margin-right: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}
.game-score {
  text-align: right;
}
.game-score-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}
.game-score-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 4rpx;
}
.game-orbs {
  position: relative;
  z-index: 2;
  height: 180rpx;
  margin: 20rpx 0;
}
.orb {
  position: absolute;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(47, 68, 130, 0.25), inset 0 0 20rpx rgba(255,255,255,0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  background: rgba(255, 255, 255, 0.15);
}
.orb image {
  width: 100%;
  height: 100%;
  opacity: 0.9;
}
.orb-1 { width: 96rpx; height: 96rpx; left: 40rpx; top: 40rpx; }
.orb-2 { width: 70rpx; height: 70rpx; left: 150rpx; top: 80rpx; }
.orb-3 { width: 120rpx; height: 120rpx; left: 230rpx; top: 20rpx; }
.orb-4 { width: 84rpx; height: 84rpx; left: 360rpx; top: 60rpx; }
.orb-5 { width: 60rpx; height: 60rpx; left: 480rpx; top: 90rpx; }
.game-btn {
  position: relative;
  z-index: 2;
  background: rgba(255, 255, 255, 0.95);
  color: #5c7ce8;
  display: inline-flex;
}

/* 染力榜 */
.leaderboard-section {
  margin-top: 48rpx;
}
.lb-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.lb-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a2b4d;
}
.lb-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  padding: 4rpx;
}
.lb-tab {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #6b7a9a;
  border-radius: 999rpx;
}
.lb-tab.active {
  background: #fff;
  color: #1a2b4d;
  box-shadow: 0 4rpx 12rpx rgba(47, 68, 130, 0.1);
}
.lb-card {
  padding: 24rpx 28rpx;
}
.lb-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}
.lb-row:last-child {
  border-bottom: none;
}
.lb-rank {
  width: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #f4b400;
  text-align: center;
}
.lb-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin: 0 18rpx;
  background: #eef1f8;
}
.lb-name {
  flex: 1;
  font-size: 26rpx;
  color: #3a4a68;
}
.lb-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #4b6ee6;
}
.lb-more {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6b7a9a;
  padding: 12rpx 0;
}

/* 一分钟非遗 */
.knowledge-card {
  position: relative;
  margin-top: 32rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7f9ff 100%);
  box-shadow: 0 8rpx 28rpx rgba(47, 68, 130, 0.08);
  border: 1rpx solid rgba(75, 110, 230, 0.1);
  overflow: hidden;
}
.knowledge-card::after {
  content: "";
  position: absolute;
  right: -20rpx;
  bottom: -20rpx;
  width: 220rpx;
  height: 220rpx;
  background: url('/assets/patterns/cang.png') no-repeat center;
  background-size: cover;
  opacity: 0.22;
  border-radius: 50%;
}
.knowledge-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(75, 110, 230, 0.12);
  color: #4b6ee6;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}
.knowledge-title {
  position: relative;
  z-index: 1;
  width: 70%;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2b4d;
  line-height: 1.4;
}
.knowledge-desc {
  position: relative;
  z-index: 1;
  width: 70%;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7a9a;
  line-height: 1.5;
}
.knowledge-link {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #4b6ee6;
  font-weight: 600;
}
