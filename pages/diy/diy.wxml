<view class="rx-bg"></view>
<view class="diy-back-shell"><rx-back bind:back="goBack" /></view>
<scroll-view scroll-y class="diy-entry" enhanced show-scrollbar="{{false}}">
  <view class="diy-entry-content">
  <view class="entry-head">
    <view class="eyebrow">✦ MINDFUL TIE-DYE ✦</view>
    <view class="entry-title">正念 DIY</view>
    <view class="entry-sub">先感受此刻，再把它慢慢染进一块布里</view>
  </view>

  <view class="hero-card">
    <image class="hero-image" src="/assets/diy/entry-tuan.jpg" mode="aspectFill" />
    <view class="hero-wash"></view>
    <view class="hero-copy">
      <view class="hero-kicker">今天想留下些什么？</view>
      <view class="hero-quote">“让指尖慢下来，颜色会替你说话。”</view>
    </view>
  </view>

  <view class="section-head">
    <view>
      <view class="section-title">此刻的你</view>
      <view class="section-sub">选择最接近的一种感觉</view>
    </view>
    <view class="selected-pill">{{selectedMood.label}}</view>
  </view>

  <view class="mood-grid">
    <view wx:for="{{moods}}" wx:key="id"
          class="mood-card {{selectedMoodId===item.id?'selected':''}}"
          data-id="{{item.id}}" bindtap="chooseMood">
      <view class="mood-dot"></view>
      <view class="mood-label">{{item.label}}</view>
      <view class="mood-desc">{{item.desc}}</view>
      <view wx:if="{{selectedMoodId===item.id}}" class="mood-check">✓</view>
    </view>
  </view>

  <view class="steps-card">
    <view class="steps-title">今天的六步</view>
    <view class="steps-row">
      <view wx:for="{{steps}}" wx:key="*this" class="step-item">
        <view class="step-line" wx:if="{{index < steps.length - 1}}"></view>
        <view class="step-dot">{{index + 1}}</view>
        <view class="step-label">{{item}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{hasDraft}}" class="resume-card" bindtap="resumeFlow">
    <view class="resume-icon">↻</view>
    <view class="resume-copy">
      <view class="resume-title">继续上次创作</view>
      <view class="resume-sub">已进行到「{{draftStageLabel}}」，草稿仍在</view>
    </view>
    <view class="resume-arrow">›</view>
  </view>

  <view class="start-button" bindtap="startNew" hover-class="start-button-active" role="button" aria-label="开始创作，第一步选择布料">
    <view class="start-emblem"><text>染</text></view>
    <view class="start-copy">
      <view class="start-title">开始创作</view>
      <view class="start-sub">第一步 · 选择布料</view>
    </view>
    <view class="start-arrow">›</view>
    <view class="start-seam"></view>
  </view>

  <view wx:if="{{latestWork}}" class="latest-card">
    <image src="{{latestWorkImage}}" mode="aspectFill" />
    <view class="latest-copy">
      <view class="latest-kicker">最近完成</view>
      <view class="latest-title">{{latestWork.patternName || latestWork.name || '我的扎染作品'}}</view>
      <view class="latest-meta">{{latestWork.dyeName || '板蓝根'}} · {{latestWork.concentration || 60}}% 浓度</view>
      <view class="latest-actions">
        <button bindtap="goPoster">作品海报</button>
        <button bindtap="goWorks">全部作品</button>
      </view>
    </view>
  </view>

  <view class="entry-foot">植物染色 · 白族扎染 · 正念呼吸</view>
  </view>
</scroll-view>
