/* 归属：B｜核心交互 Owner
   正念 DIY 工坊：扎 / 染 / 等 / 拆 */

.diy-page {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 30rpx 160rpx;
  box-sizing: border-box;
}

/* 步骤条 */
.stepper {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 40rpx 30rpx;
  padding: 0 20rpx;
}
.stepper-line {
  position: absolute;
  left: 60rpx;
  right: 60rpx;
  top: 28rpx;
  height: 4rpx;
  background: #dbe4f5;
  z-index: 0;
}
.step-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.step-dot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #dbe4f5;
  color: #8a9bb8;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-item.done .step-dot {
  background: #4b6ee6;
  border-color: #4b6ee6;
  color: #fff;
}
.step-item.active .step-dot {
  background: #fff;
  border-color: #4b6ee6;
  color: #4b6ee6;
  box-shadow: 0 0 0 8rpx rgba(75,110,230,0.15);
}

/* 正念语录 */
.quote-card {
  margin: 0 30rpx 30rpx;
  padding: 28rpx 32rpx;
  background: rgba(255,255,255,0.88);
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(75,110,230,0.08);
}
.quote-mark {
  color: #7b5fe0;
  font-size: 36rpx;
  font-family: Georgia, serif;
  margin: 0 10rpx;
}
.quote-text {
  color: #3d4f6f;
  font-size: 30rpx;
  line-height: 1.6;
  font-weight: 500;
}

/* 画布 */
.diy-canvas {
  display: block;
  margin: 0 auto 30rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 16rpx 60rpx rgba(26,43,77,0.12);
}

/* 控制区 */
.controls {
  margin: 0 30rpx;
  padding: 28rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(75,110,230,0.08);
}
.control-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2b4d;
  margin-bottom: 24rpx;
}

/* 折叠方式 */
.fold-list {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.fold-card {
  flex: 1;
  padding: 22rpx 14rpx;
  background: #f7f9fc;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  text-align: center;
}
.fold-card.selected {
  background: #eef2ff;
  border-color: #4b6ee6;
}
.fold-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2b4d;
  margin-bottom: 8rpx;
}
.fold-desc {
  display: block;
  font-size: 22rpx;
  color: #6b7a99;
}

/* 染液 */
.dye-list {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.dye-card {
  flex: 1;
  padding: 22rpx 14rpx;
  background: #f7f9fc;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dye-card.selected {
  background: #eef2ff;
  border-color: #4b6ee6;
}
.dye-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,0.06);
}
.dye-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a2b4d;
  margin-bottom: 4rpx;
}
.dye-desc {
  display: block;
  font-size: 20rpx;
  color: #6b7a99;
  text-align: center;
}

/* 滑块 */
.slider-row {
  margin-bottom: 12rpx;
}
.slider-label {
  display: block;
  font-size: 28rpx;
  color: #3d4f6f;
  margin-bottom: 12rpx;
  font-weight: 500;
}

/* 氧化计时 */
.timer-box {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 16rpx;
}
.timer-count {
  font-size: 96rpx;
  font-weight: 200;
  color: #1a2b4d;
  line-height: 1;
}
.timer-unit {
  font-size: 32rpx;
  color: #6b7a99;
  margin-left: 12rpx;
}
.timer-hint {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #6b7a99;
  margin-bottom: 30rpx;
}

/* 呼吸圆环 */
.breath-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  margin: 0 auto 30rpx;
  background: conic-gradient(#4b6ee6, #7b5fe0, #4b6ee6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.7;
}
.breathing {
  animation: breathe 8s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50% { transform: scale(1.15); opacity: 1; }
}
.breath-inner {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.breath-text {
  font-size: 28rpx;
  color: #4b6ee6;
  font-weight: 600;
}

/* 声音开关 */
.sound-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx;
  background: #f7f9fc;
  border-radius: 16rpx;
}
.sound-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
}
.sound-text {
  font-size: 26rpx;
  color: #3d4f6f;
}

/* 保存按钮 */
.save-btn {
  margin-top: 10rpx;
}
.save-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #6b7a99;
  margin-top: 14rpx;
}

/* 底部导航 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(12rpx);
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -8rpx 32rpx rgba(26,43,77,0.06);
  z-index: 10;
}
.bottom-bar .rx-btn-primary,
.bottom-bar .rx-btn-secondary {
  flex: 1;
  margin: 0;
}

/* 电子成品卡 */
.result-mask {
  position: fixed;
  inset: 0;
  background: rgba(26,43,77,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 40rpx;
}
.result-card {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 40rpx;
  padding: 36rpx;
  text-align: center;
  box-shadow: 0 24rpx 80rpx rgba(26,43,77,0.25);
}
.result-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1a2b4d;
  margin-bottom: 24rpx;
  font-family: 'Songti SC', 'SimSun', serif;
}
.result-img {
  display: block;
  width: 560rpx;
  height: 560rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(26,43,77,0.12);
  background: #f7f9fc;
}
.result-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7a99;
  font-size: 28rpx;
}
.result-meta {
  margin-bottom: 20rpx;
}
.result-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2b4d;
  margin-bottom: 8rpx;
}
.result-line {
  display: block;
  font-size: 24rpx;
  color: #6b7a99;
  margin-bottom: 4rpx;
}
.result-story {
  color: #4b6ee6;
  line-height: 1.5;
}
.mindful-input {
  width: 100%;
  height: 120rpx;
  margin: 20rpx 0;
  padding: 18rpx;
  box-sizing: border-box;
  background: #f7f9fc;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #3d4f6f;
  text-align: left;
}
.result-card .rx-btn-primary,
.result-card .rx-btn-secondary {
  margin: 16rpx 0 0;
}

/* 15 秒创作回溯 */
.review-mask {
  position: fixed;
  inset: 0;
  background: rgba(26,43,77,0.78);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  z-index: 200;
  box-sizing: border-box;
}
.review-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.review-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  font-family: 'Songti SC', 'SimSun', serif;
}
.review-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.review-canvas {
  width: 600rpx;
  height: 600rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 16rpx 60rpx rgba(0,0,0,0.3);
}
.review-quote {
  margin: 28rpx 0 16rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.92);
  text-align: center;
  line-height: 1.6;
}
.review-progress {
  width: 600rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: rgba(255,255,255,0.2);
  overflow: hidden;
}
.review-bar {
  height: 100%;
  background: linear-gradient(90deg, #4b6ee6, #7b5fe0);
  transition: width 0.1s linear;
}
.review-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
