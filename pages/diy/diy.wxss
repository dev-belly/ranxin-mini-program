page {
  height: 100%;
  overflow: hidden;
  background: #f7f9ff;
  color: #173d79;
}

.diy-back-shell {
  position: fixed;
  z-index: 30;
  left: 24rpx;
  top: 24rpx;
  width: 56rpx;
  height: 56rpx;
}

.diy-entry {
  position: relative;
  z-index: 2;
  height: 100%;
  box-sizing: border-box;
}

.diy-entry-content {
  min-height: 100%;
  box-sizing: border-box;
  padding: 42rpx 30rpx 190rpx;
  padding-bottom: calc(190rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.entry-head { text-align: center; padding: 18rpx 20rpx 26rpx; }
.eyebrow { font-size: 20rpx; letter-spacing: 4rpx; color: #8b7cf7; }
.entry-title {
  margin-top: 10rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #164a91;
}
.entry-sub { margin-top: 12rpx; font-size: 24rpx; color: #7c88a8; letter-spacing: 1rpx; }

.hero-card {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-radius: 34rpx;
  border: 1rpx solid rgba(255,255,255,.92);
  box-shadow: 0 18rpx 42rpx rgba(46, 72, 139, .15);
}
.hero-image { width: 100%; height: 100%; }
.hero-wash {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(19,55,116,.80), rgba(50,79,155,.28) 64%, rgba(255,255,255,.06));
}
.hero-copy { position: absolute; left: 34rpx; right: 34rpx; bottom: 34rpx; color: #fff; }
.hero-kicker { font-size: 34rpx; font-weight: 700; letter-spacing: 3rpx; }
.hero-quote { margin-top: 12rpx; font-size: 23rpx; line-height: 1.6; color: rgba(255,255,255,.88); }

.section-head { margin: 34rpx 4rpx 18rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.section-title { font-size: 34rpx; font-weight: 700; letter-spacing: 2rpx; }
.section-sub { margin-top: 8rpx; font-size: 22rpx; color: #8b96b0; }
.selected-pill {
  padding: 9rpx 20rpx; border-radius: 999rpx;
  color: #5d55db; font-size: 21rpx; font-weight: 700;
  background: rgba(118,103,242,.12); border: 1rpx solid rgba(118,103,242,.22);
}

.mood-grid { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.mood-card {
  position: relative;
  width: calc(50% - 16rpx);
  min-height: 138rpx;
  box-sizing: border-box;
  margin: 8rpx;
  padding: 24rpx 26rpx 20rpx 42rpx;
  border-radius: 25rpx;
  background: rgba(255,255,255,.78);
  border: 1rpx solid rgba(202,212,239,.88);
  box-shadow: 0 9rpx 22rpx rgba(42,63,115,.07);
}
.mood-card.selected {
  background: linear-gradient(145deg, rgba(238,239,255,.98), rgba(255,255,255,.96));
  border-color: rgba(112,97,239,.80);
  box-shadow: 0 12rpx 28rpx rgba(92,79,222,.17), inset 0 0 0 2rpx rgba(255,255,255,.75);
}
.mood-dot { position: absolute; left: 20rpx; top: 34rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: #c8d0e6; }
.selected .mood-dot { background: #7568f8; box-shadow: 0 0 0 7rpx rgba(117,104,248,.12); }
.mood-label { font-size: 28rpx; font-weight: 700; color: #244a84; }
.mood-desc { margin-top: 8rpx; font-size: 20rpx; line-height: 1.45; color: #8a95ad; }
.mood-check { position: absolute; right: 15rpx; top: 15rpx; width: 30rpx; height: 30rpx; border-radius: 50%; text-align: center; line-height: 30rpx; color: #fff; background: #7568f8; font-size: 18rpx; }

.steps-card, .resume-card, .latest-card {
  margin-top: 24rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,.82);
  border: 1rpx solid rgba(205,215,238,.84);
  box-shadow: 0 12rpx 30rpx rgba(39,60,111,.09);
}
.steps-card { padding: 26rpx 20rpx 22rpx; }
.steps-title { text-align: center; font-size: 26rpx; font-weight: 700; letter-spacing: 3rpx; }
.steps-row { margin-top: 24rpx; display: flex; }
.step-item { position: relative; flex: 1; min-width: 0; text-align: center; }
.step-line { position: absolute; left: 50%; top: 16rpx; width: 100%; height: 2rpx; background: #d9dfef; }
.step-dot { position: relative; z-index: 1; width: 34rpx; height: 34rpx; margin: 0 auto; border-radius: 50%; line-height: 34rpx; color: #fff; font-size: 18rpx; background: linear-gradient(135deg,#5577ed,#876bf2); }
.step-label { margin-top: 10rpx; font-size: 18rpx; color: #6f7b99; white-space: nowrap; transform: scale(.92); }

.resume-card { display: flex; align-items: center; padding: 24rpx 28rpx; }
.resume-icon { width: 58rpx; height: 58rpx; border-radius: 50%; line-height: 58rpx; text-align: center; color: #fff; background: linear-gradient(135deg,#5577ed,#876bf2); font-size: 30rpx; }
.resume-copy { flex: 1; margin-left: 20rpx; }
.resume-title { font-size: 27rpx; font-weight: 700; }
.resume-sub { margin-top: 6rpx; font-size: 21rpx; color: #8b96ae; }
.resume-arrow { font-size: 48rpx; color: #6e68e6; }

.start-button {
  position: relative;
  height: 108rpx;
  margin: 26rpx 0 0;
  padding: 0 27rpx 0 20rpx;
  overflow: hidden;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  color: #173f75;
  background-color: #fffdf7;
  background-image: repeating-linear-gradient(0deg,rgba(43,71,113,.022) 0 1rpx,transparent 1rpx 7rpx),repeating-linear-gradient(90deg,rgba(116,82,42,.018) 0 1rpx,transparent 1rpx 9rpx);
  border: 2rpx solid rgba(35,77,128,.18);
  box-shadow: 0 12rpx 27rpx rgba(45,67,108,.12), inset 0 1rpx 0 rgba(255,255,255,.95);
  transition: transform .16s ease, box-shadow .16s ease;
}
.start-button-active { transform: scale(.985); box-shadow: 0 6rpx 16rpx rgba(45,67,108,.10); }
.start-seam { position: absolute; inset: 8rpx; border-radius: 21rpx; border: 1.5rpx dashed rgba(30,77,129,.28); pointer-events: none; }
.start-emblem { position: relative; z-index: 2; width: 66rpx; height: 66rpx; flex: 0 0 66rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fffdf6; background: #174b83; border: 5rpx double #d9c7a6; box-sizing: border-box; box-shadow: 0 5rpx 12rpx rgba(22,66,113,.19); }
.start-emblem text { margin: 0; font: 700 28rpx/1 "Songti SC","STSong",serif; }
.start-copy { position: relative; z-index: 2; flex: 1; min-width: 0; margin-left: 20rpx; white-space: nowrap; }
.start-title { font: 700 28rpx/1.15 "Songti SC","STSong","PingFang SC",serif; letter-spacing: 3rpx; }
.start-sub { margin-top: 8rpx; color: #78839b; font: 19rpx/1.1 -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; letter-spacing: 1rpx; }
.start-arrow { position: relative; z-index: 2; width: 50rpx; height: 50rpx; flex: 0 0 50rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; padding: 0 0 4rpx 3rpx; box-sizing: border-box; color: #fff; background: #315f98; border: 1rpx solid rgba(255,255,255,.6); font: 34rpx/1 sans-serif; box-shadow: 0 4rpx 10rpx rgba(36,74,124,.17); }
.latest-actions button::after { border: 0; }

.latest-card { display: flex; padding: 18rpx; }
.latest-card > image { width: 190rpx; height: 190rpx; border-radius: 24rpx; background: #edf1fb; }
.latest-copy { flex: 1; min-width: 0; padding: 10rpx 6rpx 4rpx 24rpx; }
.latest-kicker { color: #7b70ee; font-size: 20rpx; letter-spacing: 2rpx; }
.latest-title { margin-top: 8rpx; font-size: 30rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.latest-meta { margin-top: 8rpx; font-size: 21rpx; color: #8b96ae; }
.latest-actions { margin-top: 18rpx; display: flex; gap: 12rpx; }
.latest-actions button { flex: 1; height: 54rpx; line-height: 54rpx; margin: 0; padding: 0 10rpx; border-radius: 28rpx; color: #5262cd; background: #eef0ff; font-size: 20rpx; }

.entry-foot { padding: 34rpx 0 16rpx; text-align: center; color: #a0a9bd; font-size: 20rpx; letter-spacing: 2rpx; }
