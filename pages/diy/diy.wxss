/* 归属：B｜核心交互 Owner · rx 水彩主题统一 */
.diy-page {
  min-height: 100vh;
  background: transparent;
  padding-bottom: 160rpx;
}

.stepper {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 30rpx 30rpx 10rpx;
  position: relative;
}
.stepper-line {
  position: absolute;
  top: 54rpx;
  left: 60rpx;
  right: 60rpx;
  height: 2rpx;
  background: rgba(75, 110, 230, 0.18);
  z-index: 0;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}
.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid rgba(75, 110, 230, 0.25);
  color: #8a93a6;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-item.active .step-dot,
.step-item.done .step-dot {
  background: linear-gradient(135deg, #4b6ee6 0%, #7b5fe0 100%);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(93, 95, 220, 0.28);
}
.step-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8a93a6;
}
.step-item.active .step-label {
  color: #4b6ee6;
  font-weight: 600;
}

.step-panel {
  padding: 30rpx;
}
.step-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1a2b4d;
  margin-bottom: 10rpx;
  font-family: "Songti SC", "STSong", serif;
  letter-spacing: 2rpx;
}
.step-subtitle {
  display: block;
  font-size: 26rpx;
  color: #6b7790;
  margin-bottom: 30rpx;
}

.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.mood-card {
  width: 200rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(47, 68, 130, 0.08);
  border: 2rpx solid transparent;
}
.mood-card.selected {
  border-color: #7b5fe0;
  background: rgba(123, 95, 224, 0.08);
}
.mood-emoji {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.mood-label {
  font-size: 26rpx;
  color: #2c3a4f;
}

.fabric-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.fabric-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 22rpx rgba(47, 68, 130, 0.08);
  border: 2rpx solid transparent;
}
.fabric-card.selected {
  border-color: #7b5fe0;
  background: rgba(123, 95, 224, 0.06);
}
.fabric-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  opacity: 0.85;
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.4);
}
.fabric-info {
  flex: 1;
}
.fabric-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2b4d;
  display: block;
}
.fabric-tag {
  display: inline-block;
  background: rgba(75, 110, 230, 0.12);
  color: #4b6ee6;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin: 8rpx 0;
}
.fabric-desc {
  font-size: 24rpx;
  color: #6b7790;
  display: block;
}

.pattern-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.cat-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}
.cat-btn {
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.8);
  color: #5b6c8a;
  font-size: 26rpx;
  border: 1rpx solid rgba(75, 110, 230, 0.18);
}
.cat-btn.active {
  background: linear-gradient(135deg, #4b6ee6 0%, #7b5fe0 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(93, 95, 220, 0.2);
}
.pattern-card {
  width: 300rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(47, 68, 130, 0.08);
  border: 2rpx solid transparent;
  text-align: center;
}
.pattern-card.selected {
  border-color: #7b5fe0;
  background: rgba(123, 95, 224, 0.06);
}
.pattern-thumb {
  width: 120rpx;
  height: 120rpx;
  background: rgba(75, 110, 230, 0.08);
  border-radius: 50%;
  margin: 0 auto 16rpx;
}
.pattern-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2b4d;
  display: block;
}
.pattern-tags {
  font-size: 22rpx;
  color: #6b7790;
}

.editor-panel {
  padding-bottom: 40rpx;
}
.diy-canvas {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(47, 68, 130, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  display: block;
  margin: 0 auto 30rpx;
}
.diy-canvas.small {
  height: 400rpx;
}

.editor-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}
.tab {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.8);
  color: #5b6c8a;
  font-size: 26rpx;
  border: 1rpx solid rgba(75, 110, 230, 0.18);
}
.tab.active {
  background: linear-gradient(135deg, #4b6ee6 0%, #7b5fe0 100%);
  color: #fff;
  border-color: transparent;
}

.sliders {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(47, 68, 130, 0.06);
}
.slider-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}
.slider-row text {
  font-size: 26rpx;
  color: #2c3a4f;
  margin-bottom: 6rpx;
}

.tip-box {
  margin-top: 24rpx;
  background: rgba(75, 110, 230, 0.08);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #4b6ee6;
}

.dye-list {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}
.dye-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}
.dye-item.selected text {
  color: #4b6ee6;
  font-weight: 600;
}
.dye-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
  border: 3rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(47, 68, 130, 0.14);
}
.dye-item.selected .dye-circle {
  border-color: #7b5fe0;
}

.method-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 8rpx 22rpx rgba(47, 68, 130, 0.06);
}
.method-card.selected {
  border-color: #7b5fe0;
  background: rgba(123, 95, 224, 0.06);
}
.method-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.method-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2b4d;
}
.method-badge {
  background: linear-gradient(135deg, #4b6ee6 0%, #7b5fe0 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}
.method-desc {
  font-size: 24rpx;
  color: #6b7790;
  display: block;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.92);
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(47, 68, 130, 0.08);
  backdrop-filter: blur(10rpx);
}
button {
  margin: 0;
  padding: 0;
  border: none;
  outline: none;
}
.ghost-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #4b6ee6;
  font-size: 30rpx;
  border: 1rpx solid rgba(75, 110, 230, 0.25);
}
.primary-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #4b6ee6 0%, #7b5fe0 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(93, 95, 220, 0.25);
}
.primary-btn[disabled] {
  opacity: 0.5;
}
