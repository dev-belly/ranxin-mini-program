/* 2.7 DIY海报记录 · 作品海报页（对齐 HTML：蓝紫清透、纸张感、海报主体 + 底部双按钮 + 载体弹窗） */
.poster-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 150rpx);
  color: #173677;
  font-family: "Songti SC", "STSong", "PingFang SC", serif;
  background:
    radial-gradient(430rpx 320rpx at 97% 6%, rgba(140, 171, 244, .27), transparent 68%),
    radial-gradient(330rpx 250rpx at 5% 18%, rgba(210, 220, 255, .34), transparent 70%),
    radial-gradient(300rpx 270rpx at 100% 57%, rgba(184, 171, 241, .18), transparent 72%),
    radial-gradient(390rpx 300rpx at 0% 78%, rgba(151, 195, 244, .18), transparent 72%),
    linear-gradient(180deg, #fdfdff 0%, #fbfcff 50%, #f8faff 100%);
}

.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  padding-top: env(safe-area-inset-top);
  box-sizing: content-box;
}
.back {
  width: 67rpx;
  height: 67rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-size: 52rpx;
  font-weight: 300;
  color: #173e62;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 8rpx 22rpx rgba(46, 69, 101, .14);
}
.back:active { transform: scale(.95); }
.nav-title {
  font-size: 35rpx;
  font-weight: 700;
  letter-spacing: 7rpx;
  color: #183b5d;
}
.nav-right {
  width: 67rpx;
  height: 67rpx;
}
.share-btn {
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 8rpx 22rpx rgba(46, 69, 101, .14);
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-btn::after { border: 0; }
.share-btn:active { transform: scale(.95); }
.share-icon {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #173e62;
  border-radius: 6rpx;
  position: relative;
}
.share-icon:before {
  content: "";
  position: absolute;
  left: -14rpx;
  top: -10rpx;
  width: 26rpx;
  height: 4rpx;
  background: #173e62;
  border-radius: 4rpx;
  transform: rotate(-38deg);
}
.share-icon:after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: -20rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #173e62;
  border-radius: 50%;
  background: #fff;
}

/* 海报主体 */
.poster-wrap {
  margin-top: 22rpx;
  border-radius: 38rpx;
  overflow: hidden;
  box-shadow: 0 15rpx 32rpx rgba(56, 76, 110, .08);
  background: #f7f4ee;
  position: relative;
}
.poster-img {
  width: 100%;
  height: auto;
  display: block;
}
.poster-loading {
  height: 900rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #7c86a6;
  font-size: 26rpx;
}
.loading-orb {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #526cff, #956aff);
  opacity: .85;
  animation: orb-pulse 1.1s ease-in-out infinite;
}
.poster-failed { gap: 17rpx; color: #697896; }
.error-mark { width: 65rpx; height: 65rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font: 38rpx/1 Arial,sans-serif; background: linear-gradient(135deg,#5671dc,#8d6bd8); }
.retry-poster { height: 68rpx; margin: 5rpx 0 0; padding: 0 30rpx; border-radius: 35rpx; color: #fff; font-size: 24rpx; background: linear-gradient(100deg,#315da8,#765ec9); }
.retry-poster::after { border: 0; }
@keyframes orb-pulse {
  0%, 100% { transform: scale(.82); opacity: .5; }
  50% { transform: scale(1.1); opacity: .95; }
}

/* 底部操作 */
.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 40rpx calc(env(safe-area-inset-bottom) + 26rpx);
  display: flex;
  gap: 30rpx;
  z-index: 10;
  background: linear-gradient(180deg, rgba(250, 251, 255, 0), rgba(246, 248, 253, .96) 34%);
}
.btn {
  flex: 1;
  height: 100rpx;
  border-radius: 31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.btn:active { transform: scale(.98); }
.save {
  position: relative;
  border: 0;
  color: #fff;
  background: linear-gradient(135deg, #184e73, #0f4568 55%, #183e5d);
  box-shadow: 0 8rpx 19rpx rgba(25, 62, 91, .18);
  overflow: hidden;
}
.save.disabled { opacity: .55; }
.save-star {
  position: absolute;
  right: 66rpx;
  top: 20rpx;
  color: #fff;
  font-size: 22rpx;
}
.real {
  border: 2rpx solid #244d70;
  color: #173b5f;
  background: rgba(255, 255, 255, .70);
}
.real .arrow {
  font-size: 39rpx;
  font-weight: 400;
  line-height: 1;
}

/* 隐藏海报画布 */
.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 320px;
  height: 656px;
}

/* 载体弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(28, 44, 67, .24);
  backdrop-filter: blur(7rpx);
  -webkit-backdrop-filter: blur(7rpx);
}
.modal-mask.show { display: flex; }
.modal {
  width: 688rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, .97);
  padding: 44rpx 46rpx 42rpx;
  border: 1rpx solid rgba(69, 96, 130, .12);
  box-shadow: 0 28rpx 70rpx rgba(34, 54, 84, .23);
  position: relative;
  box-sizing: border-box;
}
.modal-close {
  position: absolute;
  right: 24rpx;
  top: 17rpx;
  width: 44rpx;
  height: 44rpx;
  color: #8290a3;
  font-size: 39rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-title {
  text-align: center;
  color: #173b5f;
  font-size: 36rpx;
  font-weight: 700;
}
.modal-desc {
  margin-top: 14rpx;
  text-align: center;
  color: #718092;
  font-size: 24rpx;
  line-height: 1.7;
}
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 26rpx;
}
.product {
  position: relative;
  height: 140rpx;
  border: 1rpx solid rgba(58, 85, 119, .15);
  border-radius: 25rpx;
  background: #f7f8f9;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  color: #305271;
  font-size: 25rpx;
}
.product.selected {
  border-color: #315f87;
  background: #edf4f8;
  box-shadow: inset 0 0 0 1rpx #315f87;
}
.product-img {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  flex: 0 0 auto;
  background: #fff;
}
.product-check {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #315f87;
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-action {
  margin-top: 28rpx;
  width: 100%;
  height: 70rpx;
  border-radius: 25rpx;
  color: #fff;
  background: linear-gradient(135deg, #1f567b, #244b70);
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-action:active { transform: scale(.985); }
