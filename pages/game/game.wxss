.game-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 标题（对齐 A：✦合成大染缸✦ + ✿副标题✿） */
.title-wrap {
  text-align: center;
  margin: 8rpx 0 20rpx;
}
.title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #203e9c;
}
.title::before, .title::after {
  content: "✦";
  font: 20rpx Arial;
  color: #8887f2;
  margin: 0 17rpx;
  vertical-align: middle;
}
.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: #5e6ea7;
}
.subtitle::before, .subtitle::after {
  content: "✿";
  font: 18rpx Arial;
  color: #6e77dd;
  margin: 0 21rpx;
}

/* HUD（对齐 A .stat 白卡圆角 + 深蓝数字） */
.game-hud {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.hud-card {
  position: relative;
  flex: 1;
  background:
    var(--glass-sheen),
    linear-gradient(135deg, rgba(255, 255, 255, 0.30), rgba(255, 255, 255, 0.08)), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(22px) saturate(200%);
  backdrop-filter: blur(22px) saturate(200%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 34rpx;
  padding: 18rpx 10rpx;
  text-align: center;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.18), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.hud-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 1.4rpx rgba(255, 255, 255, 0.42);
}
.hud-label {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #3153aa;
}
.hud-value {
  font-size: 38rpx;
  font-weight: 500;
  color: #2944c1;
  letter-spacing: 2rpx;
  margin-top: 6rpx;
}
.mute-card { display: flex; flex-direction: column; justify-content: center; }

/* 残片进度 */
.frag-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.frag-item {
  flex: 1;
  position: relative;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(14px) saturate(190%);
  backdrop-filter: blur(14px) saturate(190%);
  border: 1rpx solid rgba(255,211,107,0.6);
  border-radius: 20rpx;
  padding: 12rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.frag-name { font-size: 24rpx; color: #173d79; }
.frag-count { font-size: 26rpx; font-weight: 700; color: #c08a16; }

/* 棋盘：竖屏更高的落球区 */
.board-wrap {
  width: 100%;
  aspect-ratio: 3 / 4;
  background: linear-gradient(160deg, #5c8df5, #2b5bc7);
  border-radius: 28rpx;
  padding: 12rpx;
  box-sizing: border-box;
  box-shadow: inset 0 4rpx 18rpx rgba(255,255,255,0.35), inset 0 -8rpx 20rpx rgba(20,40,90,0.35), 0 16rpx 40rpx rgba(43,91,199,0.25);
}
.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 20rpx;
}

/* 正念提示语 */
.quote-toast {
  position: relative;
  margin: 22rpx auto 0;
  max-width: 90%;
  text-align: center;
  font-size: 26rpx;
  color: #2a44c1;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(14px) saturate(190%);
  backdrop-filter: blur(14px) saturate(190%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  box-shadow: inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
  opacity: 0;
  transform: translateY(8rpx);
  transition: opacity .4s, transform .4s;
}
.quote-toast.show { opacity: 1; transform: translateY(0); }

.game-tip {
  margin: 18rpx 8rpx 0;
  font-size: 22rpx;
  color: #8b97b3;
  text-align: center;
  line-height: 1.6;
}

/* 结果弹窗（对齐 A image6） */
.result-mask {
  position: fixed; inset: 0; background: rgba(26,43,77,0.45);
  display: flex; justify-content: center; z-index: 50; padding: 40rpx 28rpx;
  overflow-y: auto;
}
.result-card {
  position: relative; width: 100%; max-width: 640rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(30px) saturate(210%) brightness(108%);
  backdrop-filter: blur(30px) saturate(210%) brightness(108%);
  border: 1rpx solid var(--glass-border-bright); border-radius: 34rpx;
  padding: 40rpx 32rpx; margin: auto 0;
  box-shadow: 0 24rpx 70rpx rgba(26, 43, 77, 0.34), var(--glass-thickness);
  overflow: hidden;
}
.result-card::before {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background: radial-gradient(130% 90% at 50% -12%, rgba(255,255,255,0.30), transparent 46%);
}
.result-card::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(120% 120% at 50% 0%, rgba(255,255,255,0.22), transparent 42%),
    radial-gradient(120% 120% at 50% 100%, rgba(255,255,255,0.12), transparent 42%);
  box-shadow: var(--glass-edge);
}
.result-head { text-align: center; position: relative; z-index: 1; margin-bottom: 28rpx; }
.result-title { font-family: "Songti SC", serif; font-size: 44rpx; font-weight: 700; color: #173d79; }
.result-subtitle { display: block; margin-top: 8rpx; font-size: 22rpx; color: #5d7099; }

.reward-card {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 22rpx; padding: 26rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  border: 1rpx solid var(--glass-border); border-radius: 28rpx;
  box-shadow: var(--glass-shadow), var(--glass-thickness); margin-bottom: 24rpx;
}
.reward-left { flex: 1; text-align: left; }
.reward-label { font-size: 24rpx; color: #5d7099; }
.reward-name { font-family: "Songti SC", serif; font-size: 44rpx; font-weight: 700; color: #173d79; margin: 10rpx 0; }
.reward-added { font-size: 22rpx; color: #2a44c1; }
.reward-img { width: 160rpx; height: 160rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,.35); }

.score-card {
  position: relative; z-index: 1; text-align: left; padding: 26rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  border: 1rpx solid var(--glass-border); border-radius: 28rpx;
  box-shadow: var(--glass-shadow), var(--glass-thickness); margin-bottom: 24rpx;
}
.score-label { font-size: 24rpx; color: #5d7099; }
.score-main { font-size: 68rpx; font-weight: 800; color: #2a44c1; margin: 8rpx 0 6rpx; }
.score-icon { font-size: 34rpx; margin-right: 10rpx; }
.score-unit { font-size: 28rpx; font-weight: 500; margin-left: 8rpx; }
.score-percent { font-size: 24rpx; color: #5d7099; margin-bottom: 22rpx; }
.score-stats { display: flex; gap: 14rpx; }
.score-stat {
  flex: 1; display: flex; align-items: center; gap: 12rpx; padding: 18rpx 14rpx;
  background: rgba(255,255,255,.35); border-radius: 20rpx;
}
.score-stat-icon { width: 48rpx; height: 48rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(52,122,240,.12); color: #2a44c1; font-size: 24rpx; }
.score-stat-num { font-size: 30rpx; font-weight: 700; color: #173d79; }
.score-stat-label { font-size: 20rpx; color: #5d7099; margin-top: 2rpx; }

.result-quote {
  position: relative; z-index: 1; display: flex; align-items: flex-start; gap: 14rpx;
  padding: 22rpx; margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(52,122,240,.10), rgba(161,96,239,.08)), var(--glass-bg);
  border-radius: 24rpx; border: 1rpx solid var(--glass-border);
}
.quote-star { font-size: 28rpx; color: #6e86e8; }
.quote-text { flex: 1; font-size: 24rpx; color: #4f5f7a; line-height: 1.6; }

.result-btn { width: 100%; position: relative; z-index: 1; }
.result-actions {
  position: relative; z-index: 1; display: flex; justify-content: space-between; gap: 20rpx; margin-top: 22rpx;
}
.result-action {
  flex: 1; padding: 22rpx 0; border-radius: 999rpx; font-size: 28rpx; text-align: center;
  background: var(--glass-sheen), var(--glass-bg-strong); color: #2a44c1;
  border: 1rpx solid var(--glass-border-bright); box-shadow: var(--glass-shadow), var(--glass-thickness);
}

.library-head {
  position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center;
  margin-top: 28rpx; font-size: 28rpx; font-weight: 700; color: #173d79;
}
.library-more { font-size: 22rpx; color: #5d7099; font-weight: 400; }
.library-row {
  position: relative; z-index: 1; display: flex; gap: 20rpx; margin-top: 16rpx;
}
.library-item { flex: 1; text-align: center; }
.library-thumb { width: 100%; height: 140rpx; border-radius: 20rpx; border: 2rpx solid rgba(255,255,255,.35); }
.library-name { margin-top: 8rpx; font-size: 22rpx; color: #4f5f7a; }
