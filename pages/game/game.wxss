/* 归属：B｜核心交互 Owner（按设计稿 image5/image6 重制） */

.game-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部 HUD */
.game-hud {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-top: 24rpx;
  margin-bottom: 16rpx;
}
.hud-left, .hud-right {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  min-width: 140rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(47, 68, 130, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.hud-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 0 16rpx;
}
.hud-label, .hud-best-label {
  font-size: 22rpx;
  color: #6b7a9a;
}
.hud-score, .hud-best {
  font-size: 40rpx;
  font-weight: 700;
  color: #4b6ee6;
  margin-top: 4rpx;
}
.hud-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a2b4d;
  font-family: "Songti SC", serif;
  letter-spacing: 4rpx;
}
.hud-next {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hud-next-label {
  font-size: 20rpx;
  color: #8a93a6;
}
.hud-next-ball {
  margin-top: 8rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 6rpx 16rpx rgba(47, 68, 130, 0.15), inset 0 0 16rpx rgba(255, 255, 255, 0.5);
  background: #fff;
}
.hud-next-ball image {
  width: 100%;
  height: 100%;
}

/* 染缸容器 */
.board-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  margin: 8rpx 0 16rpx;
}
.board-frame {
  flex: 1;
  border-radius: 48rpx;
  padding: 16rpx;
  background: linear-gradient(180deg, #5c8df5 0%, #3d6fd9 60%, #2b5bc7 100%);
  box-shadow:
    inset 0 4rpx 20rpx rgba(255, 255, 255, 0.35),
    inset 0 -6rpx 24rpx rgba(0, 0, 0, 0.15),
    0 14rpx 40rpx rgba(47, 68, 130, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  position: relative;
  overflow: hidden;
}
.board-frame::before {
  content: "";
  position: absolute;
  top: -20%;
  left: -20%;
  width: 80%;
  height: 70%;
  background: radial-gradient(ellipse at 30% 20%, rgba(255,255,255,0.25), transparent 60%);
  pointer-events: none;
  z-index: 2;
}
.game-canvas {
  width: 100%;
  height: 100%;
  border-radius: 36rpx;
  background: rgba(30, 60, 120, 0.15);
}
.board-hint {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hint-star {
  color: #8fa7e8;
  font-size: 22rpx;
  margin: 0 12rpx;
}
.hint-text {
  font-size: 24rpx;
  color: #6b7a9a;
}

/* 底部道具栏 */
.power-bar {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.power-btn {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 20rpx 0;
  box-shadow: 0 6rpx 18rpx rgba(47, 68, 130, 0.08);
  border: 1rpx solid rgba(75, 110, 230, 0.12);
}
.power-btn.active {
  background: linear-gradient(135deg, #4b6ee6 0%, #7b5fe0 100%);
  color: #fff;
  border-color: transparent;
}
.power-btn.disabled {
  opacity: 0.45;
}
.power-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(75, 110, 230, 0.12);
  color: #4b6ee6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}
.power-btn.active .power-icon-wrap {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}
.power-name {
  font-size: 24rpx;
  color: #5b6c8a;
}
.power-btn.active .power-name { color: #fff; }
.power-count {
  position: absolute;
  top: 8rpx;
  right: 16rpx;
  background: #4b6ee6;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.power-btn.active .power-count { background: rgba(255,255,255,0.3); }

/* 结果弹窗 */
.result-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(245, 247, 252, 0.92);
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}
.result-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(47, 68, 130, 0.12);
  margin: auto 0;
}
.result-header {
  text-align: center;
  margin-bottom: 24rpx;
}
.result-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a2b4d;
  font-family: "Songti SC", serif;
}
.result-subtitle {
  font-size: 24rpx;
  color: #8a93a6;
  margin-top: 8rpx;
}

.unlock-box {
  background: linear-gradient(135deg, #f4f6ff 0%, #f8f4ff 100%);
  border-radius: 28rpx;
  padding: 28rpx;
  text-align: center;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}
.unlock-box::after {
  content: "";
  position: absolute;
  right: -30rpx;
  top: -30rpx;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(123, 95, 224, 0.15), transparent 70%);
}
.unlock-label {
  font-size: 24rpx;
  color: #6b7a9a;
}
.unlock-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #4b6ee6;
  margin: 8rpx 0;
}
.unlock-meta {
  font-size: 22rpx;
  color: #8a93a6;
}
.unlock-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  margin: 16rpx auto 0;
  display: block;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(47, 68, 130, 0.1);
}

.score-panel {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
  border: 1rpx solid rgba(75, 110, 230, 0.1);
}
.score-row {
  display: inline-flex;
  align-items: baseline;
  justify-content: center;
}
.star {
  color: #4b6ee6;
  font-size: 28rpx;
  margin-right: 12rpx;
}
.score-num {
  font-size: 80rpx;
  font-weight: 700;
  color: #1a2b4d;
  line-height: 1;
}
.score-unit {
  font-size: 30rpx;
  color: #6b7a9a;
  margin-left: 8rpx;
}
.score-percent {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7b5fe0;
  font-weight: 600;
}

.result-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  min-width: 140rpx;
}
.stat-icon {
  font-size: 32rpx;
  color: #4b6ee6;
  margin-bottom: 4rpx;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a2b4d;
}
.stat-label {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 4rpx;
}

.result-tip {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, #f4f6ff 0%, #f8f4ff 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}
.tip-icon {
  font-size: 36rpx;
  color: #7b5fe0;
  margin-right: 16rpx;
  line-height: 1;
}
.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #5b6c8a;
  line-height: 1.6;
}

.result-btn {
  width: 100%;
  margin-bottom: 20rpx;
}
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.result-half {
  flex: 1;
}

.mini-collection {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(75, 110, 230, 0.1);
}
.mc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.mc-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2b4d;
}
.mc-count {
  font-size: 22rpx;
  color: #8a93a6;
}
.mc-list {
  display: flex;
  justify-content: space-between;
}
.mc-item {
  width: 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mc-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f4f6fb;
  margin-bottom: 8rpx;
}
.mc-item text {
  font-size: 22rpx;
  color: #5b6c8a;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: normal;
}
button::after { border: none; }
