.game-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 标题（对齐 A：✦合成大染缸✦ + ✿副标题✿） */
.title-wrap {
  text-align: center;
  margin: 8rpx 0 20rpx;
}
.title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #203e9c;
}
.title::before, .title::after {
  content: "✦";
  font: 20rpx Arial;
  color: #8887f2;
  margin: 0 17rpx;
  vertical-align: middle;
}
.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: #5e6ea7;
}
.subtitle::before, .subtitle::after {
  content: "✿";
  font: 18rpx Arial;
  color: #6e77dd;
  margin: 0 21rpx;
}

/* HUD（对齐 A .stat 白卡圆角 + 深蓝数字） */
.game-hud {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.hud-card {
  position: relative;
  flex: 1;
  background:
    var(--glass-sheen),
    linear-gradient(135deg, rgba(255, 255, 255, 0.30), rgba(255, 255, 255, 0.08)), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(22px) saturate(200%);
  backdrop-filter: blur(22px) saturate(200%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 34rpx;
  padding: 18rpx 10rpx;
  text-align: center;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.18), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.hud-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 1.4rpx rgba(255, 255, 255, 0.42);
}
.hud-label {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #3153aa;
}
.hud-value {
  font-size: 38rpx;
  font-weight: 500;
  color: #2944c1;
  letter-spacing: 2rpx;
  margin-top: 6rpx;
}
.mute-card { display: flex; flex-direction: column; justify-content: center; }

/* 残片进度 */
.frag-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.frag-item {
  flex: 1;
  position: relative;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(14px) saturate(190%);
  backdrop-filter: blur(14px) saturate(190%);
  border: 1rpx solid rgba(255,211,107,0.6);
  border-radius: 20rpx;
  padding: 12rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.frag-name { font-size: 24rpx; color: #173d79; }
.frag-count { font-size: 26rpx; font-weight: 700; color: #c08a16; }

/* 棋盘：竖屏更高的落球区 */
.board-wrap {
  width: 100%;
  aspect-ratio: 3 / 4;
  background: linear-gradient(160deg, #5c8df5, #2b5bc7);
  border-radius: 28rpx;
  padding: 12rpx;
  box-sizing: border-box;
  box-shadow: inset 0 4rpx 18rpx rgba(255,255,255,0.35), inset 0 -8rpx 20rpx rgba(20,40,90,0.35), 0 16rpx 40rpx rgba(43,91,199,0.25);
}
.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 20rpx;
}

/* 正念提示语 */
.quote-toast {
  position: relative;
  margin: 22rpx auto 0;
  max-width: 90%;
  text-align: center;
  font-size: 26rpx;
  color: #2a44c1;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(14px) saturate(190%);
  backdrop-filter: blur(14px) saturate(190%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  box-shadow: inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
  opacity: 0;
  transform: translateY(8rpx);
  transition: opacity .4s, transform .4s;
}
.quote-toast.show { opacity: 1; transform: translateY(0); }

.game-tip {
  margin: 18rpx 8rpx 0;
  font-size: 22rpx;
  color: #8b97b3;
  text-align: center;
  line-height: 1.6;
}

/* 结果弹窗 */
.result-mask {
  position: fixed;
  inset: 0;
  background: rgba(26,43,77,0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  padding: 40rpx;
}
.result-card {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  background:
    var(--glass-sheen),
    linear-gradient(135deg, rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.10)), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(30px) saturate(210%) brightness(108%);
  backdrop-filter: blur(30px) saturate(210%) brightness(108%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  text-align: center;
  box-shadow: 0 24rpx 70rpx rgba(26, 43, 77, 0.34), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(20, 30, 70, 0.20);
  overflow: hidden;
}
.result-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 1.4rpx rgba(255, 255, 255, 0.42);
}
.result-title {
  font-family: "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 700;
  color: #173d79;
  margin-bottom: 28rpx;
}
.result-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}
.stat { display: flex; flex-direction: column; }
.stat-num { font-size: 44rpx; font-weight: 800; color: #2a44c1; }
.stat-label { font-size: 22rpx; color: #8b97b3; margin-top: 4rpx; }
.frag-result {
  font-size: 24rpx;
  color: #c08a16;
  background: rgba(255,211,107,0.16);
  border-radius: 16rpx;
  padding: 14rpx;
  margin-bottom: 24rpx;
}
.result-eyebrow {
  font-size: 30rpx;
  font-weight: 700;
  color: #173d79;
  font-family: "Songti SC", "STSong", serif;
  margin-bottom: 8rpx;
}
.result-eyebrow .rx-spark { margin-right: 8rpx; }
.result-done {
  display: inline-block;
  font-size: 22rpx;
  color: #2a44c1;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(14px) saturate(190%);
  backdrop-filter: blur(14px) saturate(190%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  margin-bottom: 28rpx;
  box-shadow: inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.result-detail {
  position: relative;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(18px) saturate(200%);
  backdrop-filter: blur(18px) saturate(200%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  text-align: left;
  box-shadow: inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.detail-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #173d79;
  margin-bottom: 16rpx;
}
.detail-row { display: flex; align-items: center; }
.detail-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(52,122,240,0.25);
  flex: 0 0 auto;
  margin-right: 20rpx;
}
.detail-info { flex: 1; }
.detail-name { font-size: 30rpx; font-weight: 700; color: #173d79; }
.detail-story { font-size: 24rpx; color: #4f5f7a; margin-top: 8rpx; line-height: 1.6; }
.detail-added {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #2a44c1;
  font-weight: 600;
  text-align: center;
}
.result-sub {
  font-size: 26rpx;
  color: #173d79;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.mini-collection {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}
.mini-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(52,122,240,0.25);
}
.unlock-tag {
  font-size: 24rpx;
  color: #c08a16;
  background: rgba(255,211,107,0.16);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}
.result-btn { width: 100%; }
.result-actions {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 22rpx;
}
.result-link {
  font-size: 26rpx;
  color: #2a44c1;
}
