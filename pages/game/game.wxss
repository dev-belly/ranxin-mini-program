/* 归属：B｜核心交互 Owner */
.game-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #E8EDF5 0%, #D6DDEA 100%);
}

.game-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
}
.score-box, .next-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.7);
  border-radius: 20rpx;
  padding: 14rpx 24rpx;
}
.score-label {
  font-size: 22rpx;
  color: #5F6B80;
}
.score-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #2C3A4F;
}
.title-box {
  text-align: center;
}
.game-title {
  display: block;
  font-size: 36rpx;
  font-weight: 500;
  color: #2C3A4F;
}
.game-subtitle {
  font-size: 22rpx;
  color: #7D879C;
}
.next-ball {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-top: 6rpx;
  border: 2rpx solid rgba(255,255,255,0.6);
}

.board-wrap {
  flex: 1;
  margin: 0 24rpx 20rpx;
  position: relative;
}
.game-canvas {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.35);
}

.power-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.power-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #F0F4FA;
  border-radius: 20rpx;
  padding: 16rpx 30rpx;
  min-width: 140rpx;
}
.power-btn.active {
  background: #4A5D7A;
  color: #fff;
}
.power-btn.disabled {
  opacity: 0.4;
}
.power-icon {
  font-size: 36rpx;
}
.power-name {
  font-size: 24rpx;
  margin-top: 4rpx;
}
.power-count {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  background: #4A5D7A;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.result-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.result-card {
  width: 640rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 40rpx;
  text-align: center;
}
.result-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #2C3A4F;
  display: block;
}
.result-subtitle {
  font-size: 24rpx;
  color: #7D879C;
  display: block;
  margin-bottom: 20rpx;
}
.unlock-box {
  background: #F0F4FA;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.unlock-box text {
  display: block;
  font-size: 24rpx;
  color: #5F6B80;
}
.unlock-name {
  font-size: 34rpx !important;
  color: #4A5D7A !important;
  font-weight: 500;
}
.unlock-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin: 0 auto 16rpx;
  display: block;
  background: #fff;
}
.result-score {
  font-size: 80rpx;
  font-weight: 600;
  color: #4A5D7A;
  line-height: 1;
}
.result-unit {
  font-size: 26rpx;
  color: #7D879C;
}
.result-stats {
  display: flex;
  justify-content: space-around;
  margin: 30rpx 0;
}
.stat {
  display: flex;
  flex-direction: column;
}
.stat text:first-child {
  font-size: 34rpx;
  font-weight: 500;
  color: #2C3A4F;
}
.stat text:last-child {
  font-size: 22rpx;
  color: #7D879C;
}
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
button {
  margin: 0;
  padding: 0;
  border: none;
}
.primary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(90deg, #4A5D7A, #6A7CA0);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.ghost-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: #F0F4FA;
  color: #4A5D7A;
  border-radius: 38rpx;
  font-size: 26rpx;
}
