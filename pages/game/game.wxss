.game-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* HUD */
.game-hud {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.hud-card {
  flex: 1;
  background: rgba(255,255,255,0.92);
  border-radius: 24rpx;
  padding: 18rpx 10rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(43,91,199,0.10);
}
.hud-label {
  font-size: 22rpx;
  color: #6b7a99;
}
.hud-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a2b4d;
  margin-top: 6rpx;
}
.mute-card { display: flex; flex-direction: column; justify-content: center; }

/* 残片进度 */
.frag-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.frag-item {
  flex: 1;
  background: rgba(255,255,255,0.78);
  border: 1rpx solid rgba(255,211,107,0.6);
  border-radius: 20rpx;
  padding: 12rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.frag-name { font-size: 24rpx; color: #1a2b4d; }
.frag-count { font-size: 26rpx; font-weight: 700; color: #c08a16; }

/* 棋盘：竖屏更高的落球区 */
.board-wrap {
  width: 100%;
  aspect-ratio: 3 / 4;
  background: linear-gradient(160deg, #5c8df5, #2b5bc7);
  border-radius: 28rpx;
  padding: 12rpx;
  box-sizing: border-box;
  box-shadow: inset 0 4rpx 18rpx rgba(255,255,255,0.35), inset 0 -8rpx 20rpx rgba(20,40,90,0.35), 0 16rpx 40rpx rgba(43,91,199,0.25);
}
.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 20rpx;
}

/* 正念提示语 */
.quote-toast {
  margin: 22rpx auto 0;
  max-width: 90%;
  text-align: center;
  font-size: 26rpx;
  color: #4b6ee6;
  background: rgba(255,255,255,0.85);
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  opacity: 0;
  transform: translateY(8rpx);
  transition: opacity .4s, transform .4s;
}
.quote-toast.show { opacity: 1; transform: translateY(0); }

.game-tip {
  margin: 18rpx 8rpx 0;
  font-size: 22rpx;
  color: #8b97b3;
  text-align: center;
  line-height: 1.6;
}

/* 结果弹窗 */
.result-mask {
  position: fixed;
  inset: 0;
  background: rgba(26,43,77,0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  padding: 40rpx;
}
.result-card {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255,255,255,0.96);
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(26,43,77,0.3);
}
.result-title {
  font-family: "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 700;
  color: #1a2b4d;
  margin-bottom: 28rpx;
}
.result-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}
.stat { display: flex; flex-direction: column; }
.stat-num { font-size: 44rpx; font-weight: 800; color: #4b6ee6; }
.stat-label { font-size: 22rpx; color: #8b97b3; margin-top: 4rpx; }
.frag-result {
  font-size: 24rpx;
  color: #c08a16;
  background: rgba(255,211,107,0.16);
  border-radius: 16rpx;
  padding: 14rpx;
  margin-bottom: 24rpx;
}
.result-sub {
  font-size: 26rpx;
  color: #1a2b4d;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.mini-collection {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}
.mini-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(75,110,230,0.25);
}
.unlock-tag {
  font-size: 24rpx;
  color: #c08a16;
  background: rgba(255,211,107,0.16);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}
.result-btn { width: 100%; }
.result-actions {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 22rpx;
}
.result-link {
  font-size: 26rpx;
  color: #4b6ee6;
}
