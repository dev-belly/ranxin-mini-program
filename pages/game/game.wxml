<view class="rx-page game-page">
  <view class="rx-bg"></view>

  <!-- 标题（对齐 A：✦合成大染缸✦ + ✿副标题✿） -->
  <view class="title-wrap">
    <view class="title">合成大染缸</view>
    <view class="subtitle">把烦恼一颗颗合掉</view>
  </view>

  <!-- HUD -->
  <view class="game-hud">
    <view class="hud-card">
      <view class="hud-label">得分</view>
      <view class="hud-value">{{score}}</view>
    </view>
    <view class="hud-card">
      <view class="hud-label">历史最高</view>
      <view class="hud-value">{{best}}</view>
    </view>
    <view class="hud-card">
      <view class="hud-label">目前最高</view>
      <view class="hud-value">{{topName}}</view>
    </view>
    <view class="hud-card mute-card" bindtap="toggleMute">
      <view class="hud-label">音景</view>
      <view class="hud-value">{{muted ? '静音' : '开'}}</view>
    </view>
  </view>

  <!-- 棋盘 -->
  <view class="board-wrap">
    <canvas type="2d" id="game-canvas" class="game-canvas"
      bindtouchstart="onTouchMove" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd"></canvas>
  </view>

  <!-- 正念提示语 -->
  <view class="quote-toast {{quoteVisible ? 'show' : ''}}">{{quote}}</view>

  <view class="game-tip">移动手指瞄准，松手投下扎染球 · 相同纹样相撞即合体升级 · 一直合到「大染缸」</view>

  <!-- 结果弹窗（对齐 A image6：奖励收获 / 纹样详情 / 本局数据 / 纹样库 / 操作） -->
  <view class="result-mask" wx:if="{{gameOver}}">
    <view class="result-card">
      <view class="result-head">
        <view class="result-title">奖励收获</view>
        <text class="result-subtitle">你的灵魂扎染之旅又多了一份美好印记 ✦</text>
      </view>

      <view class="reward-card">
        <view class="reward-left">
          <view class="reward-label">恭喜你获得</view>
          <view class="reward-name">{{result.topPattern.name}}</view>
          <view class="reward-added">已加入你的纹样库 ✓</view>
        </view>
        <image class="reward-img" src="{{result.topPattern.thumb}}" mode="aspectFill"/>
      </view>

      <view class="score-card">
        <view class="score-label">这一局，你收获了</view>
        <view class="score-main"><text class="score-icon">✦</text>{{result.score}}<text class="score-unit">分</text></view>
        <view class="score-percent">超过了 {{result.percent}}% 的玩家</view>
        <view class="score-stats">
          <view class="score-stat">
            <view class="score-stat-icon">✿</view>
            <view>
              <view class="score-stat-num">{{result.createdCount}}</view>
              <view class="score-stat-label">本局合成</view>
            </view>
          </view>
          <view class="score-stat">
            <view class="score-stat-icon">◷</view>
            <view>
              <view class="score-stat-num">{{result.timeMinutes}}</view>
              <view class="score-stat-label">分钟沉浸</view>
            </view>
          </view>
          <view class="score-stat">
            <view class="score-stat-icon">✦</view>
            <view>
              <view class="score-stat-num">{{result.eliminatedCount}}</view>
              <view class="score-stat-label">消除纹样球</view>
            </view>
          </view>
        </view>
      </view>

      <view class="result-quote" wx:if="{{result.quote}}">
        <text class="quote-star">✦</text>
        <view class="quote-text">{{result.quote}}</view>
      </view>

      <button class="rx-btn-primary result-btn" bindtap="viewCollection">收下纹样 ✦</button>
      <view class="result-actions">
        <view class="result-action" bindtap="replay">↻ 再玩一局</view>
        <view class="result-action" bindtap="viewRank">♕ 查看排行榜</view>
      </view>

      <view class="library-head">
        <text>我的纹样库</text>
        <text class="library-more" bindtap="viewCollection">已收集 {{result.unlockedPatterns.length}} 个纹样 ›</text>
      </view>
      <view class="library-row">
        <view wx:for="{{result.unlockedPatterns}}" wx:key="id" class="library-item">
          <image class="library-thumb" src="{{item.thumb}}" mode="aspectFill"/>
          <view class="library-name">{{item.name}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
