<view class="rx-page game-page">
  <view class="rx-bg"></view>

  <!-- HUD -->
  <view class="game-hud">
    <view class="hud-card">
      <view class="hud-label">得分</view>
      <view class="hud-value">{{score}}</view>
    </view>
    <view class="hud-card">
      <view class="hud-label">历史最高</view>
      <view class="hud-value">{{best}}</view>
    </view>
    <view class="hud-card">
      <view class="hud-label">剩余步数</view>
      <view class="hud-value">{{moves}}</view>
    </view>
    <view class="hud-card mute-card" bindtap="toggleMute">
      <view class="hud-label">音景</view>
      <view class="hud-value">{{muted ? '静音' : '开'}}</view>
    </view>
  </view>

  <!-- 残片收集进度 -->
  <view class="frag-bar">
    <view class="frag-item">
      <text class="frag-name">蝴蝶纹残片</text>
      <text class="frag-count">{{fragments.hudie}}/1</text>
    </view>
    <view class="frag-item">
      <text class="frag-name">万字纹残片</text>
      <text class="frag-count">{{fragments.wanzi}}/1</text>
    </view>
  </view>

  <!-- 棋盘 -->
  <view class="board-wrap" bindtap="onBoardTap">
    <canvas type="2d" id="game-canvas" class="game-canvas"></canvas>
  </view>

  <!-- 正念提示语 -->
  <view class="quote-toast {{quoteVisible ? 'show' : ''}}">{{quote}}</view>

  <view class="game-tip">交换相邻两块，连成三个及以上同纹样即可消除 · 把「残片」沉到底部即可收集解锁</view>

  <!-- 结果弹窗 -->
  <view class="result-mask" wx:if="{{gameOver}}">
    <view class="result-card">
      <view class="result-title">这一缸，染成了</view>
      <view class="result-stats">
        <view class="stat"><text class="stat-num">{{result.score}}</text><text class="stat-label">本局得分</text></view>
        <view class="stat"><text class="stat-num">{{result.timeMinutes}}</text><text class="stat-label">分钟沉浸</text></view>
        <view class="stat"><text class="stat-num">{{result.percent}}%</text><text class="stat-label">超过玩家</text></view>
      </view>

      <view class="frag-result" wx:if="{{result.fragments.hudie || result.fragments.wanzi}}">
        <text class="frag-result-label">本局收集残片：</text>
        <text wx:if="{{result.fragments.hudie}}">蝴蝶纹残片 ×{{result.fragments.hudie}}　</text>
        <text wx:if="{{result.fragments.wanzi}}">万字纹残片 ×{{result.fragments.wanzi}}</text>
      </view>

      <view class="result-sub">我的纹样库</view>
      <view class="mini-collection">
        <image wx:for="{{result.unlockedPatterns}}" wx:key="id" class="mini-thumb" src="{{item.thumb}}" mode="aspectFill"/>
      </view>

      <button class="rx-btn-primary result-btn" bindtap="replay">再染一缸</button>
      <view class="result-actions">
        <text class="result-link" bindtap="viewCollection">查看纹样库</text>
        <text class="result-link" bindtap="viewRank">排行榜</text>
      </view>
    </view>
  </view>
</view>
