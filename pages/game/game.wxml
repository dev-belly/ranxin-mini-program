<!-- 归属：B｜核心交互 Owner（按设计稿 image5/image6 重制） -->
<view class="rx-bg"></view>
<view class="game-page">

  <!-- 顶部 HUD -->
  <view class="game-hud">
    <view class="hud-left">
      <view class="hud-label">得分</view>
      <view class="hud-score">{{score}}</view>
    </view>
    <view class="hud-center">
      <view class="hud-title">合成大染缸</view>
      <view wx:if="{{!gameOver}}" class="hud-next">
        <text class="hud-next-label">下一颗</text>
        <view class="hud-next-ball">
          <image src="{{nextThumb}}" mode="aspectFill" />
        </view>
      </view>
    </view>
    <view class="hud-right">
      <view class="hud-best-label">历史最高</view>
      <view class="hud-best">{{best}}</view>
    </view>
  </view>

  <!-- 游戏画布 / 染缸 -->
  <view class="board-wrap">
    <view class="board-frame">
      <canvas
        type="2d"
        id="game-canvas"
        class="game-canvas"
        style="width:100%;height:100%"
        bindtap="onBoardTap"
        bindtouchmove="onBoardMove"
      ></canvas>
    </view>
    <view class="board-hint">
      <text class="hint-star">✦</text>
      <text class="hint-text">相同纹样碰在一起，就会慢慢缩小</text>
      <text class="hint-star">✦</text>
    </view>
  </view>

  <!-- 底部道具栏 -->
  <view class="power-bar">
    <view class="power-btn {{powerChange<=0?'disabled':''}}" bindtap="useChange">
      <view class="power-icon-wrap">↻</view>
      <text class="power-name">换一次</text>
      <text class="power-count">×{{powerChange}}</text>
    </view>
    <view class="power-btn {{powerRemove<=0?'disabled':''}} {{removeMode?'active':''}}" bindtap="useRemove">
      <view class="power-icon-wrap">✂</view>
      <text class="power-name">消除一个</text>
      <text class="power-count">×{{powerRemove}}</text>
    </view>
    <view class="power-btn {{muted?'active':''}}" bindtap="toggleMute">
      <view class="power-icon-wrap">{{muted?'🔇':'🔊'}}</view>
      <text class="power-name">静音</text>
    </view>
  </view>

  <!-- 游戏结束 / 奖励收获 -->
  <view wx:if="{{gameOver}}" class="result-mask">
    <view class="result-card">
      <view class="result-header">
        <view class="result-title">奖励收获</view>
        <view class="result-subtitle">你的灵魂扎染之旅又多了一份美好印记 ✦</view>
      </view>

      <view wx:if="{{result.unlock}}" class="unlock-box">
        <view class="unlock-label">恭喜你获得</view>
        <view class="unlock-name">{{result.unlock.name}}</view>
        <view class="unlock-meta">已加入你的纹样库 ◎</view>
        <image class="unlock-img" src="{{result.unlock.thumb}}" mode="aspectFill" />
      </view>

      <view class="score-panel">
        <view class="score-row">
          <view class="star">✦</view>
          <view class="score-num">{{result.score}}</view>
          <view class="score-unit">分</view>
        </view>
        <view class="score-percent">超过了 {{result.percent}}% 的玩家</view>
      </view>

      <view class="result-stats">
        <view class="stat">
          <view class="stat-icon">✁</view>
          <view class="stat-num">{{result.merges}}</view>
          <view class="stat-label">本局合成</view>
        </view>
        <view class="stat">
          <view class="stat-icon">◷</view>
          <view class="stat-num">{{result.timeMinutes}}</view>
          <view class="stat-label">分钟</view>
        </view>
        <view class="stat">
          <view class="stat-icon">✦</view>
          <view class="stat-num">{{result.eliminated}}</view>
          <view class="stat-label">消除纹球</view>
        </view>
      </view>

      <view class="result-tip">
        <text class="tip-icon">★</text>
        <view class="tip-text">每一次专注与选择，都是在靠近更真实的自己。再接再厉，收集更多独特的灵魂纹样吧！</view>
      </view>

      <view class="rx-btn-primary result-btn" bindtap="collectPattern">收下纹样 ✦</view>
      <view class="result-actions">
        <view class="rx-btn-secondary result-half" bindtap="replay">再玩一局（30题）</view>
        <view class="rx-btn-secondary result-half" bindtap="viewRank">查看排行榜</view>
      </view>

      <view class="mini-collection">
        <view class="mc-header">
          <text class="mc-title">我的纹样库</text>
          <text class="mc-count" bindtap="viewCollection">已收集 {{result.unlockedCount}} 个纹样 ></text>
        </view>
        <view class="mc-list">
          <view wx:for="{{result.unlockedPatterns}}" wx:key="id" class="mc-item">
            <image src="{{item.thumb}}" mode="aspectFill" />
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
