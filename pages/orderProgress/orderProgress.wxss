.progress-page { padding-top: calc(env(safe-area-inset-top) + 86rpx); padding-bottom: 48rpx; }

.nav-bar {
  display: flex; align-items: flex-start; justify-content: space-between;
  margin-bottom: 24rpx;
}
.back {
  width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; color: #173d79;
  background: var(--glass-sheen), var(--glass-bg-strong);
  border: 1.5rpx solid var(--glass-border-bright); border-radius: 50%;
  box-shadow: var(--glass-thickness); flex-shrink: 0;
}
.nav-center { flex: 1; text-align: center; padding: 0 20rpx; }
.nav-title {
  font-size: 36rpx; font-weight: 700; color: #173d79; letter-spacing: 2rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
}
.title-spark { color: #8884ef; font-size: 22rpx; }
.nav-sub { font-size: 22rpx; color: #8b97b3; margin-top: 8rpx; }
.nav-right { width: 60rpx; }

.order-card {
  display: flex; align-items: center; gap: 22rpx;
  padding: 28rpx; margin-bottom: 38rpx;
  background: rgba(255,255,255,.58);
}
.order-img {
  width: 150rpx; height: 150rpx; border-radius: 20rpx;
  background: #eef1f8; flex-shrink: 0;
}
.order-info { flex: 1; }
.order-title { font-size: 30rpx; font-weight: 700; color: #173d79; }
.order-tags { margin: 12rpx 0; display: flex; gap: 10rpx; }
.order-eta { font-size: 24rpx; color: #2a44c1; }

.timeline-card { padding: 34rpx 28rpx; margin-bottom: 34rpx; background: rgba(255,255,255,.20); }
.timeline {}
.step {
  display: flex; gap: 24rpx; padding-bottom: 42rpx;
}
.step:last-child { padding-bottom: 0; }
.dot-wrap {
  display: flex; flex-direction: column; align-items: center;
  width: 32rpx; flex-shrink: 0;
}
.dot {
  width: 30rpx; height: 30rpx; border-radius: 50%;
  background: rgba(20, 30, 70, 0.12);
  border: 4rpx solid transparent;
}
.step.done .dot {
  background: var(--brand-grad);
  border-color: rgba(93, 120, 253, 0.2);
}
.step.done .dot::after { content: "✓"; display: block; color: #fff; font-size: 18rpx; line-height: 30rpx; text-align: center; }
.step.active .dot {
  background: #fff;
  border-color: #5d78fd;
  box-shadow: 0 0 0 6rpx rgba(93, 120, 253, 0.12);
}
.line {
  flex: 1; width: 4rpx; min-height: 60rpx;
  background: rgba(20, 30, 70, 0.08);
  margin: 8rpx 0;
}
.step.done + .step .line,
.step.done .line { background: linear-gradient(180deg, #5d78fd, rgba(93,120,253,0.2)); }

.step-body { flex: 1; }
.step-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6rpx; }
.step-label { font-size: 28rpx; font-weight: 700; color: #173d79; }
.step.active .step-label { color: #2a44c1; }
.step-date { font-size: 22rpx; color: #8b97b3; }
.step-desc { font-size: 22rpx; color: #4f5f7a; line-height: 1.6; }
.active-desc { margin-top: 16rpx; padding: 18rpx 22rpx; border: 1rpx solid rgba(119,114,232,.18); border-radius: 24rpx; background: rgba(255,255,255,.24); }

.tip-card {
  display: flex; align-items: center; gap: 18rpx;
  padding: 24rpx;
}
.tip-icon {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: var(--glass-sheen), rgba(52, 122, 240, 0.16);
  border: 1.5rpx solid rgba(52, 122, 240, 0.25);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  position: relative; color: #746de3; font-size: 38rpx; text-align: center; line-height: 60rpx;
}
.tip-spark { position: absolute; right: -6rpx; top: -14rpx; font-size: 18rpx; }
.tip-text { flex: 1; }
.tip-title { font-size: 26rpx; font-weight: 700; color: #173d79; }
.tip-sub { font-size: 22rpx; color: #8b97b3; margin-top: 4rpx; }
.tip-btn {
  font-size: 24rpx; color: #2a44c1; font-weight: 600; white-space: nowrap;
  padding: 14rpx 20rpx; border: 1rpx solid rgba(61,82,180,.16); border-radius: 999rpx;
}
