.art-page { padding-top: 40rpx; }
.art-hero { margin-bottom: 28rpx; }
.art-spark { font-size: 44rpx; font-weight: 700; color: #173d79; font-family: "Songti SC","STSong",serif; }
.art-spark .rx-spark { margin-right: 10rpx; }
.art-sub { font-size: 26rpx; color: #4f5f7a; margin-top: 12rpx; line-height: 1.5; }
.art-hero-line {
  display: inline-block;
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2a44c1;
  background: linear-gradient(135deg, rgba(52,122,240,0.14), rgba(161,96,239,0.14)), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  box-shadow: inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
}

.art-intro {
  padding: 32rpx;
  font-size: 28rpx;
  color: #3d4f6f;
  line-height: 1.7;
  margin-bottom: 24rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(20px) saturate(170%);
  backdrop-filter: blur(20px) saturate(170%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 31rpx;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.16), inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
}

.art-cover {
  display: block;
  width: 100%;
  border-radius: 31rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.16), inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
  border: 1.5rpx solid var(--glass-border-bright);
}
.art-img {
  display: block;
  width: 100%;
  border-radius: 20rpx;
  margin-top: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 45, 90, 0.12);
}

.art-section {
  display: flex;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(20px) saturate(170%);
  backdrop-filter: blur(20px) saturate(170%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 31rpx;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.16), inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
}
.art-num {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #347af0, #5d78fd 42%, #a160ef);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.art-section-body { flex: 1; }
.art-h { font-size: 32rpx; font-weight: 700; color: #173d79; margin-bottom: 16rpx; }
.art-p { font-size: 28rpx; color: #3d4f6f; line-height: 1.7; }
.art-chem {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #2a44c1;
  font-weight: 600;
  background: rgba(52,122,240,0.08);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}
.art-items { margin-top: 16rpx; display: flex; flex-direction: column; gap: 14rpx; }
.art-item { display: flex; align-items: baseline; }
.art-item-k {
  flex: 0 0 160rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2a44c1;
}
.art-item-v { flex: 1; font-size: 26rpx; color: #3d4f6f; line-height: 1.5; }
.art-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #4f5f7a;
  background: linear-gradient(135deg, rgba(52,122,240,0.12), rgba(161,96,239,0.10)), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(14px) saturate(170%);
  backdrop-filter: blur(14px) saturate(170%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-left: 6rpx solid #a160ef;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  box-shadow: inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
}
.art-foot {
  text-align: center;
  font-size: 26rpx;
  color: #8b97b3;
  margin: 20rpx 0 40rpx;
}
