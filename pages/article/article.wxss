.art-page { padding-top: 40rpx; }
.art-hero { margin-bottom: 28rpx; }
.art-spark { font-size: 44rpx; font-weight: 700; color: #173d79; font-family: "Songti SC","STSong",serif; }
.art-spark .rx-spark { margin-right: 10rpx; }
.art-sub { font-size: 26rpx; color: #62749b; margin-top: 12rpx; line-height: 1.5; }
.art-hero-line {
  display: inline-block;
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #3a55c8;
  background: linear-gradient(90deg, rgba(52,122,240,0.10), rgba(161,96,239,0.10));
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}

.art-intro {
  padding: 32rpx;
  font-size: 28rpx;
  color: #3d4f6f;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.art-section {
  display: flex;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.art-num {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #347af0, #5d78fd 42%, #a160ef);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.art-section-body { flex: 1; }
.art-h { font-size: 32rpx; font-weight: 700; color: #173d79; margin-bottom: 16rpx; }
.art-p { font-size: 28rpx; color: #3d4f6f; line-height: 1.7; }
.art-chem {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #3a55c8;
  font-weight: 600;
  background: rgba(75,110,230,0.08);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}
.art-items { margin-top: 16rpx; display: flex; flex-direction: column; gap: 14rpx; }
.art-item { display: flex; align-items: baseline; }
.art-item-k {
  flex: 0 0 160rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #3a55c8;
}
.art-item-v { flex: 1; font-size: 26rpx; color: #3d4f6f; line-height: 1.5; }
.art-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #62749b;
  background: rgba(75,110,230,0.06);
  border-left: 6rpx solid #7b5fe0;
  border-radius: 8rpx;
  padding: 14rpx 18rpx;
}
.art-foot {
  text-align: center;
  font-size: 26rpx;
  color: #8b97b3;
  margin: 20rpx 0 40rpx;
}
