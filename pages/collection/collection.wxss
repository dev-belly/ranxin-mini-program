/* 归属：B｜核心交互 Owner · rx 水彩主题统一 */
.collection-page {
  min-height: 100vh;
  background: transparent;
  padding: 40rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
}
.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #173d79;
  font-family: "Songti SC", "STSong", serif;
  letter-spacing: 4rpx;
}
.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #6b7790;
  margin-bottom: 30rpx;
}

.filter-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.unlock-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(16px) saturate(170%);
  backdrop-filter: blur(16px) saturate(170%);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.16), inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
  border: 1.5rpx solid var(--glass-border-bright);
}
.unlock-progress {
  flex: 1;
  min-width: 0;
}
.unlock-text {
  display: block;
  font-size: 26rpx;
  color: #173d79;
  margin-bottom: 12rpx;
}
.progress-bar {
  height: 14rpx;
  background: rgba(52, 122, 240, 0.12);
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #2a44c1 0%, #a160ef 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
.banner-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #2a44c1 0%, #a160ef 100%);
  color: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  box-shadow: 0 8rpx 18rpx rgba(101, 124, 253, 0.22);
}
.filter-btn {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  color: #5b6c8a;
  font-size: 26rpx;
  border: 1.5rpx solid var(--glass-border-bright);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}
.filter-btn.active {
  background: linear-gradient(135deg, rgba(42, 68, 193, .92), rgba(161, 96, 239, .92));
  color: #fff;
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(101, 124, 253, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

.pattern-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.pattern-card {
  width: 324rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(18px) saturate(170%);
  backdrop-filter: blur(18px) saturate(170%);
  border-radius: 28rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.16), inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
  border: 1.5rpx solid var(--glass-border-bright);
  position: relative;
}
.pattern-card.locked {
  opacity: 0.6;
}
.pattern-thumb {
  width: 220rpx;
  height: 220rpx;
  background: rgba(52, 122, 240, 0.08);
  border-radius: 50%;
  margin: 0 auto 16rpx;
  display: block;
}
.pattern-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #173d79;
}
.pattern-tags {
  display: block;
  font-size: 22rpx;
  color: #6b7790;
  margin-top: 4rpx;
}
.lock-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(26, 43, 77, 0.55);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 43, 77, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.detail-card {
  width: 560rpx;
  background: var(--glass-sheen), rgba(255, 255, 255, 0.40);
  -webkit-backdrop-filter: blur(26px) saturate(180%);
  backdrop-filter: blur(26px) saturate(180%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 36rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 24rpx 70rpx rgba(26, 43, 77, 0.34), inset 0 1.5rpx 1rpx rgba(255,255,255,0.95), inset 0 -1.5rpx 1rpx rgba(24,32,64,0.10);
  overflow: hidden;
}
.detail-canvas {
  width: 400rpx;
  height: 400rpx;
  background: rgba(52, 122, 240, 0.08);
  border-radius: 50%;
  margin: 0 auto 24rpx;
  display: block;
}
.detail-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #173d79;
  font-family: "Songti SC", "STSong", serif;
}
.detail-tags {
  display: block;
  font-size: 24rpx;
  color: #6b7790;
  margin: 8rpx 0 20rpx;
}
.detail-story {
  display: block;
  font-size: 26rpx;
  color: #5b6c8a;
  line-height: 1.6;
  margin-bottom: 30rpx;
}
button {
  margin: 0;
  padding: 0;
  border: none;
}
.primary-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #2a44c1 0%, #a160ef 100%);
  color: #fff;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(101, 124, 253, 0.25);
}
