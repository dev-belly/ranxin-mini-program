.product-page {
  padding-top: 10rpx;
  padding-bottom: 0;
}

.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 62rpx;
  padding: max(calc(env(safe-area-inset-top) + 10rpx), 82rpx) 28rpx 10rpx 32rpx;
  box-sizing: content-box;
  z-index: 20;
}
.nav-title {
  flex: 1;
  min-width: 0;
  padding-left: 18rpx;
  text-align: center;
  white-space: nowrap;
  font-size: 35rpx; font-weight: 700; color: #173d79; letter-spacing: 3rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
}
.nav-right {
  width: 184rpx;
  min-width: 184rpx;
  height: 56rpx;
}

.preview-card {
  position: relative;
  padding: 8rpx;
  display: flex; flex-direction: column; align-items: center;
  margin-bottom: 30rpx;
  overflow: hidden;
}
.artwork-proof {
  position: absolute;
  left: 28rpx;
  bottom: 26rpx;
  z-index: 4;
  min-width: 220rpx;
  padding: 9rpx 14rpx 9rpx 9rpx;
  border-radius: 23rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #274477;
  background: rgba(255,255,255,.9);
  border: 1rpx solid rgba(255,255,255,.95);
  box-shadow: 0 9rpx 25rpx rgba(28,48,98,.16);
}
.artwork-proof image { width: 72rpx; height: 72rpx; flex: 0 0 auto; border-radius: 17rpx; background: #eaf0fb; }
.artwork-proof > view { display: flex; flex-direction: column; gap: 4rpx; }
.artwork-proof > view text:first-child { font-size: 21rpx; font-weight: 700; }
.artwork-proof > view text:last-child { font-size: 17rpx; color: #73809c; }
.preview-img {
  width: 100%; height: 552rpx; border-radius: 27rpx;
  background: #eef1f8; object-fit: cover;
  box-shadow: 0 16rpx 48rpx rgba(20, 30, 70, 0.12);
}
.pattern-tag {
  position: absolute; right: 28rpx; bottom: 26rpx; z-index: 3;
  max-width: 300rpx;
  padding: 10rpx 20rpx; background: rgba(255,255,255,.9);
  box-shadow: 0 8rpx 24rpx rgba(29,54,108,.12);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tag-flower { color: #5d64de; margin-right: 8rpx; }

.options-block { margin-bottom: 28rpx; }
.opt-group { margin-bottom: 26rpx; }
.opt-label {
  font-size: 32rpx; font-weight: 700; color: #173d79;
  margin-bottom: 14rpx; display: flex; align-items: center; gap: 8rpx;
}
.opt-label::before {
  content: "✦"; font-size: 22rpx; color: #6e6deb;
}
.opt-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.opt-chips .rx-chip {
  min-height: 60rpx;
  margin: 0;
  padding: 12rpx 27rpx;
  box-sizing: border-box;
  justify-content: center;
}
.opt-chips-type {
  flex-wrap: nowrap;
}
.opt-chips-type .rx-chip {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
  padding-right: 8rpx;
}

.workshop-card {
  padding: 30rpx;
  margin-bottom: 0;
  min-height: 210rpx;
  background:
    radial-gradient(260rpx 190rpx at 94% 76%, rgba(113,150,236,.18), transparent 68%),
    var(--glass-sheen), var(--glass-bg-strong);
}
.ws-label {
  display: inline-flex; align-items: center;
  font-size: 22rpx; color: #2a44c1;
  padding: 6rpx 14rpx; border-radius: 999rpx;
  background: rgba(52, 122, 240, 0.12);
  margin-bottom: 14rpx;
}
.ws-title {
  font-size: 34rpx; font-weight: 700; color: #173d79; margin-bottom: 12rpx;
}
.ws-meta {
  font-size: 24rpx; color: #4f5f7a; margin-bottom: 8rpx;
}
.ws-desc {
  font-size: 22rpx; color: #8b97b3; line-height: 1.5;
}

.bottom-spacer { height: 248rpx; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(251, 250, 248, 0.86);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-top: 1.5rpx solid var(--glass-border);
  z-index: 50;
}
.price-line {
  display: flex; align-items: baseline; gap: 10rpx; margin-bottom: 14rpx;
}
.price-symbol { font-size: 30rpx; color: #2a44c1; font-weight: 600; }
.price-num { font-size: 52rpx; color: #2a44c1; font-weight: 700; line-height: 1; }
.price-note { font-size: 22rpx; color: #8b97b3; }
.actions { display: flex; gap: 16rpx; }
.actions .rx-btn-secondary,
.actions .rx-btn-primary {
  flex: 1;
  min-width: 0;
  width: 0;
  height: 88rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 28rpx;
  line-height: 1;
}
.bargain-btn { gap: 11rpx; white-space: nowrap; }
.people-icon {
  position: relative;
  width: 34rpx;
  height: 29rpx;
  flex: 0 0 34rpx;
}
.people-head-one,
.people-head-two {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border: 2.5rpx solid #3650b5;
  border-radius: 50%;
  box-sizing: border-box;
  background: rgba(255,255,255,.78);
}
.people-head-one { left: 5rpx; top: 0; }
.people-head-two { right: 4rpx; top: 5rpx; }
.people-shoulders {
  position: absolute;
  left: 2rpx;
  bottom: 0;
  width: 29rpx;
  height: 16rpx;
  border: 2.5rpx solid #3650b5;
  border-bottom: 0;
  border-radius: 17rpx 17rpx 0 0;
  box-sizing: border-box;
}

.duplicate-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(24, 39, 72, .28);
  -webkit-backdrop-filter: blur(10rpx);
  backdrop-filter: blur(10rpx);
}
.duplicate-dialog {
  width: 100%;
  padding: 42rpx 38rpx 36rpx;
  box-sizing: border-box;
  border-radius: 38rpx;
  text-align: center;
  background: rgba(255, 255, 255, .97);
  border: 1.5rpx solid rgba(255, 255, 255, .98);
  box-shadow: 0 28rpx 70rpx rgba(31, 48, 89, .24);
}
.duplicate-mark { color: #6764dd; font: 46rpx/1 Georgia, serif; }
.duplicate-title { margin-top: 16rpx; color: #173d79; font-size: 34rpx; font-weight: 700; }
.duplicate-copy { margin-top: 18rpx; color: #68758e; font-size: 24rpx; line-height: 1.65; }
.duplicate-actions { display: flex; gap: 16rpx; margin-top: 31rpx; }
.duplicate-btn {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 78rpx;
}
.duplicate-btn::after { border: 0; }
.duplicate-continue { color: #3e4f9c; background: rgba(80, 88, 191, .09); border: 1rpx solid rgba(72, 80, 183, .18); }
.duplicate-create { color: #fff; background: linear-gradient(90deg, #3156bb, #735bd5); box-shadow: 0 10rpx 22rpx rgba(67, 72, 184, .22); }
