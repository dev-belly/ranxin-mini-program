.detail-page { padding-top: calc(env(safe-area-inset-top) + 86rpx); padding-bottom: 310rpx; }

.nav-bar {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 18rpx;
}
.back {
  width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; color: #173d79;
  background: var(--glass-sheen), var(--glass-bg-strong);
  border: 1.5rpx solid var(--glass-border-bright); border-radius: 50%;
  box-shadow: var(--glass-thickness);
}
.share-top {
  font-size: 24rpx; color: #4f5f7a;
  padding: 10rpx 20rpx; border-radius: 999rpx;
  background: var(--glass-sheen), var(--glass-bg-strong);
  border: 1.5rpx solid var(--glass-border-bright);
  box-shadow: var(--glass-thickness);
  line-height: 1.4; margin: 0;
}
.share-top::after, .share-button::after { border: 0; }

.headline {
  text-align: center; font-size: 36rpx; font-weight: 700; color: #152c79;
  margin: 10rpx 0 34rpx; letter-spacing: 1rpx;
}

.ring-card { position: relative; padding: 20rpx 0 34rpx; margin-bottom: 10rpx; }
.ring-spark { position: absolute; color: rgba(110,104,235,.35); font-size: 34rpx; }
.spark-a { left: 120rpx; top: 80rpx; }
.spark-b { right: 100rpx; bottom: 90rpx; }
.progress-ring {
  position: relative; width: 360rpx; height: 360rpx; margin: 0 auto;
}
.ring-bg, .ring-fill, .ring-inner {
  position: absolute; border-radius: 50%;
}
.ring-bg {
  inset: 0;
  background: rgba(20, 30, 70, 0.06);
}
.ring-fill {
  inset: 0;
  border-radius: 50%;
}
.ring-inner {
  inset: 36rpx;
  background: rgba(249,249,253,.96);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: inset 0 0 30rpx rgba(20, 30, 70, 0.06);
}
.ring-label { font-size: 26rpx; color: #4f5f7a; }
.ring-amount { font-size: 72rpx; font-weight: 700; color: #2a44c1; margin: 6rpx 0; }
.ring-cut { font-size: 24rpx; color: #8b97b3; }

.product-card {
  display: flex; align-items: center; gap: 22rpx;
  padding: 26rpx; margin-bottom: 30rpx;
  background: rgba(255,255,255,.58);
}
.product-img {
  width: 150rpx; height: 150rpx; border-radius: 20rpx;
  background: #eef1f8; flex-shrink: 0;
}
.product-info { flex: 1; }
.product-title { font-size: 30rpx; font-weight: 700; color: #173d79; }
.product-sub { font-size: 22rpx; color: #8b97b3; margin-top: 10rpx; }
.product-current { font-size: 32rpx; color: #2a44c1; font-weight: 700; margin-top: 8rpx; }

.record-card { padding: 20rpx 28rpx; background: transparent; box-shadow: none; border: 0; }
.record-card::before, .record-card::after { display: none; }
.record-title {
  font-size: 28rpx; font-weight: 700; color: #173d79; margin-bottom: 18rpx;
  display: flex; align-items: center; gap: 8rpx;
}
.record-title::before { content: "✦"; font-size: 22rpx; color: #6e6deb; }
.record-list {}
.record-item {
  display: flex; align-items: center; gap: 18rpx;
  padding: 16rpx 0; border-bottom: 1rpx solid rgba(20, 30, 70, 0.06);
}
.record-item:last-child { border-bottom: none; }
.record-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: linear-gradient(135deg, #d0d8f0, #a8b6e8);
}
.record-meta { flex: 1; }
.record-name { font-size: 28rpx; color: #173d79; }
.record-time { font-size: 22rpx; color: #8b97b3; margin-top: 4rpx; }
.record-amount { font-size: 28rpx; color: #ff7a7a; font-weight: 700; }

.empty-record {
  text-align: center; color: #8b97b3; font-size: 26rpx; padding: 40rpx 0;
}

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(251, 250, 248, 0.86);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-top: 1.5rpx solid var(--glass-border);
  z-index: 50;
}
.invite-btn, .buy-btn {
  width: 100%; box-sizing: border-box; min-height: 88rpx;
  display: flex; align-items: center; justify-content: flex-start;
  padding: 14rpx 28rpx; text-align: left;
}
.invite-btn { margin-bottom: 16rpx; }
.share-button { line-height: 1.2; }
.btn-copy { flex: 1; display: flex; flex-direction: column; margin-left: 18rpx; }
.btn-sub { font-size: 20rpx; opacity: .72; font-weight: 400; margin-top: 5rpx; }
.buy-btn .btn-sub { color: #8b97b3; }
.magic-icon, .cart-icon { font-size: 44rpx; }
.arrow { font-size: 46rpx; font-weight: 300; }
