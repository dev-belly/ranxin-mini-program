<view class="rx-page kn-page">
  <view class="rx-bg"></view>
  <view class="kn-head">
    <view class="kn-spark"><text class="rx-spark">✦</text> 非遗小知识</view>
    <view class="kn-sub">一分钟，认识扎染里的自然与科学</view>
  </view>

  <view class="kn-list">
    <view wx:for="{{articles}}" wx:key="type" class="rx-card kn-card" data-type="{{item.type}}" bindtap="goArticle">
      <view class="kn-icon">{{item.icon}}</view>
      <view class="kn-body">
        <view class="kn-tag">{{item.tag}}</view>
        <view class="kn-title">{{item.title}}</view>
        <view class="kn-desc">{{item.desc}}</view>
      </view>
      <view class="kn-arrow">›</view>
    </view>
  </view>
</view>
