.kn-page { padding-top: 40rpx; }
.kn-hero {
  position: relative;
  margin-bottom: 28rpx;
  min-height: 200rpx;
  border-radius: 31rpx;
  overflow: hidden;
  background: linear-gradient(90deg, rgba(8,45,109,.66), rgba(10,50,119,.58), rgba(24,73,136,.66));
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  backdrop-filter: blur(20px) saturate(160%);
  border: 1.5rpx solid rgba(255,255,255,0.4);
  box-shadow: 0 16rpx 50rpx rgba(8,30,80,0.28), inset 0 1rpx 0 rgba(255,255,255,0.35);
}
.kn-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(90deg, rgba(7,29,71,.55) 0%, rgba(7,29,71,.40) 45%, transparent 85%);
}
.kn-hero-copy { position: relative; z-index: 3; padding: 36rpx; color: #fff; }
.kn-hero-pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  border: 1.3rpx solid rgba(255,255,255,.45);
  font-size: 22rpx;
  color: rgba(255,255,255,.86);
}
.kn-hero-title { font-size: 44rpx; font-weight: 500; letter-spacing: 2rpx; margin-top: 18rpx; line-height: 1.4; }
.kn-hero-desc { font-size: 24rpx; color: rgba(255,255,255,.74); margin-top: 10rpx; }
.kn-head { margin-bottom: 32rpx; }
.kn-spark { font-size: 42rpx; font-weight: 700; color: #173d79; font-family: "Songti SC","STSong",serif; }
.kn-spark .rx-spark { margin-right: 10rpx; }
.kn-sub { font-size: 26rpx; color: #4f5f7a; margin-top: 12rpx; }

.kn-list { display: flex; flex-direction: column; gap: 24rpx; }
.kn-card {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.10)), rgba(255, 255, 255, 0.5);
  -webkit-backdrop-filter: blur(20px) saturate(170%);
  backdrop-filter: blur(20px) saturate(170%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 31rpx;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.16), inset 0 1.5rpx 0 rgba(255, 255, 255, 0.92);
  overflow: hidden;
}
.kn-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(52,122,240,0.12), rgba(161,96,239,0.12));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex: 0 0 auto;
}
.kn-body { flex: 1; }
.kn-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #2a44c1;
  background: rgba(52,122,240,0.10);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 12rpx;
}
.kn-title { font-size: 30rpx; font-weight: 700; color: #173d79; line-height: 1.4; }
.kn-desc { font-size: 24rpx; color: #4f5f7a; margin-top: 8rpx; line-height: 1.5; }
.kn-arrow { font-size: 44rpx; color: #b9c2d6; margin-left: 12rpx; }
