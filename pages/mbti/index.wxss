.mbti-page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}
.mbti-head { text-align: center; margin-bottom: 28rpx; }
.mbti-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 700;
  color: #173d79;
}
.mbti-sub { font-size: 24rpx; color: #62749b; margin-top: 10rpx; }

.progress {
  height: 12rpx;
  background: rgba(75,110,230,0.15);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #347af0, #5d78fd 42%, #a160ef);
  border-radius: 999rpx;
  transition: width .3s;
}
.q-counter { text-align: right; font-size: 22rpx; color: #8b97b3; margin-bottom: 20rpx; }

.q-card {
  padding: 36rpx 32rpx;
}
.q-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #173d79;
  margin-bottom: 28rpx;
  line-height: 1.5;
}
.q-options { display: flex; flex-direction: column; gap: 18rpx; }
.q-opt {
  display: flex;
  align-items: center;
  background: #fff;
  border: 2rpx solid rgba(75,110,230,0.22);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: #173d79;
  text-align: left;
  line-height: 1.4;
}
.q-opt::after { border: none; }
.q-opt:active { background: rgba(75,110,230,0.10); }
.q-letter {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4b6ee6, #7b5fe0);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.q-label { flex: 1; }

/* 结果 */
.result-card { padding: 48rpx 36rpx; text-align: center; }
.result-eyebrow { font-size: 24rpx; color: #6b7a99; }
.result-type {
  font-size: 64rpx;
  font-weight: 800;
  color: #3a55c8;
  letter-spacing: 4rpx;
  margin: 8rpx 0;
}
.result-name { font-size: 32rpx; font-weight: 600; color: #173d79; }
.result-pattern {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  margin: 28rpx auto;
  border: 4rpx solid rgba(75,110,230,0.2);
}
.result-color { font-size: 28rpx; color: #3a55c8; font-weight: 600; }
.result-story { font-size: 26rpx; color: #62749b; margin: 16rpx 0 8rpx; line-height: 1.6; }
.result-tip { font-size: 24rpx; color: #8b97b3; margin-bottom: 28rpx; }
.result-card .rx-btn-primary { margin-bottom: 18rpx; }

.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 300px;
  height: 400px;
}
