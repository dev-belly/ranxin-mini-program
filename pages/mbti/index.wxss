.mbti-page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}
.mbti-head { text-align: center; margin-bottom: 28rpx; }
.mbti-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 700;
  color: #173d79;
}
.mbti-sub { font-size: 24rpx; color: #4f5f7a; margin-top: 10rpx; }

.progress {
  height: 12rpx;
  background: rgba(52,122,240,0.15);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #347af0, #5d78fd 42%, #a160ef);
  border-radius: 999rpx;
  transition: width .3s;
}
.q-counter { text-align: right; font-size: 22rpx; color: #8b97b3; margin-bottom: 20rpx; }

.q-card {
  position: relative;
  padding: 36rpx 32rpx;
  background:
    var(--glass-sheen),
    linear-gradient(135deg, rgba(255, 255, 255, 0.30), rgba(255, 255, 255, 0.08)), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(22px) saturate(200%);
  backdrop-filter: blur(22px) saturate(200%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 32rpx;
  box-shadow: 0 14rpx 44rpx rgba(31, 45, 90, 0.18), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
  overflow: hidden;
}
.q-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 1.4rpx rgba(255, 255, 255, 0.42);
}
.q-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #173d79;
  margin-bottom: 28rpx;
  line-height: 1.5;
}
.q-options { display: flex; flex-direction: column; gap: 18rpx; }
.q-opt {
  display: flex;
  align-items: center;
  position: relative;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(14px) saturate(190%);
  backdrop-filter: blur(14px) saturate(190%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: #34527d;
  text-align: left;
  line-height: 1.4;
  box-shadow: inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
}
.q-opt::after { border: none; }
.q-opt:active { background: rgba(247, 248, 255, 0.72); border-color: #778cf0; }
.q-letter {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #347af0, #5d78fd);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.q-label { flex: 1; }

/* 结果 */
.result-card {
  position: relative;
  padding: 48rpx 36rpx;
  text-align: center;
  background:
    var(--glass-sheen),
    linear-gradient(135deg, rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.10)), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(26px) saturate(210%) brightness(108%);
  backdrop-filter: blur(26px) saturate(210%) brightness(108%);
  border: 1.5rpx solid var(--glass-border-bright);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 50rpx rgba(31, 45, 90, 0.20), inset 0 1.5rpx 1rpx rgba(255, 255, 255, 0.95), inset 0 -1.5rpx 1rpx rgba(24, 32, 64, 0.10);
  overflow: hidden;
}
.result-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 1.4rpx rgba(255, 255, 255, 0.42);
}
.result-eyebrow { font-size: 24rpx; color: #4f5f7a; }
.result-type {
  font-size: 64rpx;
  font-weight: 800;
  color: #2a44c1;
  letter-spacing: 4rpx;
  margin: 8rpx 0;
}
.result-name { font-size: 32rpx; font-weight: 600; color: #173d79; }
.result-pattern {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  margin: 28rpx auto;
  border: 4rpx solid rgba(52,122,240,0.2);
}
.result-color { font-size: 28rpx; color: #2a44c1; font-weight: 600; }
.result-story { font-size: 26rpx; color: #4f5f7a; margin: 16rpx 0 8rpx; line-height: 1.6; }
.result-tip { font-size: 24rpx; color: #8b97b3; margin-bottom: 28rpx; }
.result-card .rx-btn-primary { margin-bottom: 18rpx; }

.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 300px;
  height: 400px;
}
