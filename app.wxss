/* 全局主题：染心 · 液态玻璃 v3（参考 iOS 26 + GitHub 开源 liquid-glass 技术）
   真做法核心（来自开源复刻）：
   ① 边缘折射 —— 玻璃是凸面，背后内容在边缘被透镜弯折；
   ② 对称镜面高光 —— 光从两侧进入/射出，玻璃上下边形成一圈亮环；
   ③ 薄磨砂体 + 鲜艳底层 —— 玻璃要薄，底下必须是鲜艳内容，玻璃才透得起来。
   真机 backdrop-filter / SVG 滤镜支持差，故用最强 CSS 还原：脆边 + 上下 rim 光 + 凸面顶部高光 + 鲜艳晕染底层。 */
page {
  background: #fbfaf8;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #173d79;
  -webkit-font-smoothing: antialiased;
  --glass-bg: rgba(255, 255, 255, 0.14);
  --glass-bg-strong: rgba(255, 255, 255, 0.20);
  --glass-bg-tint: rgba(255, 255, 255, 0.18);
  --glass-border: rgba(255, 255, 255, 0.45);
  --glass-border-bright: rgba(255, 255, 255, 0.62);
  /* 景深 + 玻璃厚度（顶亮底暗，模拟凸面玻璃体） */
  --glass-shadow: 0 18rpx 50rpx rgba(18, 28, 64, 0.24);
  --glass-thickness: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.9), inset 0 -2rpx 3rpx rgba(18, 28, 64, 0.12);
  /* 斜向 specular：光从左上掠过玻璃顶部（凸面高光带） */
  --glass-sheen: linear-gradient(135deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.08) 34%, rgba(255, 255, 255, 0) 56%);
  /* 边缘折射亮环（仿苹果凸面）：脆边 + 软内圈 + 顶部光 + 底部厚度暗 */
  --glass-edge:
    inset 0 0 0 1.2rpx rgba(255, 255, 255, 0.55),
    inset 0 0 0 2.6rpx rgba(255, 255, 255, 0.10),
    inset 0 3rpx 10rpx rgba(255, 255, 255, 0.30),
    inset 0 -4rpx 12rpx rgba(16, 26, 60, 0.10);
  --brand-grad: linear-gradient(90deg, #347af0 0%, #5d78fd 42%, #a160ef 100%);
}

/* 折射底层：暖白纸感 + 动态极光晕染（多层光晕缓慢漂移 / 旋转 / 呼吸，让薄玻璃透出流动色彩，玻璃才"立"得起来） */
.rx-bg {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: -1;
  overflow: hidden;
  background:
    linear-gradient(115deg, transparent 40%, rgba(120, 140, 255, .22) 49%, rgba(255, 255, 255, .05) 53%, transparent 62%) 0 0 / 280% 280%,
    radial-gradient(circle at 2rpx 2rpx, rgba(45, 82, 136, .10) 0 .7rpx, transparent .9rpx) 0 0 / 21rpx 21rpx,
    linear-gradient(180deg, #fbfaf8 0%, #faf9f6 76%, #f7f5f2 100%);
  animation: rx-sweep 7s linear infinite;
}

/* 极光光团：大幅漂移 + 旋转 + 缩放 + 色相流转（颜色像彩虹一样持续流动），叠加扫光带周期性扫过屏幕
   三招叠加，肉眼一眼就能看出背景在动。 */
.rx-bg::before,
.rx-bg::after {
  content: "";
  position: absolute;
  left: -45%; top: -45%;
  width: 190%; height: 190%;
  pointer-events: none;
  will-change: transform, opacity, filter;
  backface-visibility: hidden;
}
.rx-bg::before {
  background:
    radial-gradient(42% 42% at 24% 30%, rgba(80, 140, 255, .90), transparent 58%),
    radial-gradient(40% 40% at 70% 18%, rgba(150, 90, 255, .82), transparent 58%),
    radial-gradient(34% 34% at 86% 56%, rgba(0, 210, 255, .65), transparent 58%),
    radial-gradient(38% 38% at 14% 76%, rgba(110, 170, 255, .74), transparent 60%);
  animation: rx-aurora-a 9s ease-in-out infinite alternate, rx-hue-a 12s linear infinite;
}
.rx-bg::after {
  background:
    radial-gradient(44% 40% at 74% 70%, rgba(255, 110, 200, .60), transparent 58%),
    radial-gradient(36% 34% at 10% 26%, rgba(255, 185, 70, .55), transparent 58%),
    radial-gradient(42% 38% at 88% 88%, rgba(130, 90, 255, .62), transparent 60%),
    radial-gradient(38% 34% at 46% 6%, rgba(0, 205, 255, .52), transparent 60%);
  animation: rx-aurora-b 13s ease-in-out infinite alternate, rx-hue-b 16s linear infinite;
}

@keyframes rx-sweep {
  0%   { background-position: -140% -140%, 0 0, 0 0; }
  100% { background-position: 140% 140%, 0 0, 0 0; }
}
@keyframes rx-aurora-a {
  0%   { transform: translate3d(0, 0, 0) rotate(0deg) scale(1);       opacity: .95; }
  50%  { transform: translate3d(-24%, 16%, 0) rotate(22deg) scale(1.42); opacity: 1; }
  100% { transform: translate3d(18%, -14%, 0) rotate(-16deg) scale(1.20); opacity: .92; }
}
@keyframes rx-aurora-b {
  0%   { transform: translate3d(0, 0, 0) rotate(0deg) scale(1);       opacity: .94; }
  50%  { transform: translate3d(20%, -18%, 0) rotate(-26deg) scale(1.50); opacity: 1; }
  100% { transform: translate3d(-20%, 14%, 0) rotate(18deg) scale(1.18); opacity: .90; }
}
@keyframes rx-hue-a {
  0%   { filter: hue-rotate(0deg); }
  100% { filter: hue-rotate(360deg); }
}
@keyframes rx-hue-b {
  0%   { filter: hue-rotate(360deg); }
  100% { filter: hue-rotate(0deg); }
}

/* 通用容器 */
.rx-page { padding: 0 32rpx 140rpx; box-sizing: border-box; }

/* 通用玻璃卡 —— 薄透 + 凸面顶部高光 + 边缘折射亮环 + 景深 */
.rx-card {
  position: relative;
  background: var(--glass-sheen), var(--glass-bg);
  -webkit-backdrop-filter: blur(30px) saturate(200%) brightness(108%);
  backdrop-filter: blur(30px) saturate(200%) brightness(108%);
  border-radius: 32rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow), var(--glass-thickness);
  overflow: hidden;
}
/* 凸面顶部高光（宽光带，模拟玻璃鼓起） */
.rx-card::before {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background: radial-gradient(130% 90% at 50% -12%, rgba(255, 255, 255, 0.32), transparent 46%);
}
/* 边缘折射亮环：上下对称 rim 光（仿苹果凸面）+ 脆边 */
.rx-card::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(120% 120% at 50% 0%, rgba(255, 255, 255, 0.24), transparent 42%),
    radial-gradient(120% 120% at 50% 100%, rgba(255, 255, 255, 0.13), transparent 42%);
  box-shadow: var(--glass-edge);
}

/* 标题字体（宋体） */
.rx-title {
  font-size: 48rpx; font-weight: 700; color: #173d79; letter-spacing: 4rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
}
.rx-section-title { font-size: 36rpx; font-weight: 700; color: #173d79; margin-bottom: 20rpx; }

/* 主按钮：玻璃品牌渐变（薄高光 + 脆边 + 顶亮底暗） */
.rx-btn-primary {
  position: relative;
  background: linear-gradient(90deg, rgba(52, 122, 240, .94), rgba(93, 120, 253, .94), rgba(161, 96, 239, .94));
  -webkit-backdrop-filter: blur(12px) saturate(160%); backdrop-filter: blur(12px) saturate(160%);
  color: #fff; border-radius: 999rpx; font-size: 30rpx; font-weight: 600;
  padding: 20rpx 48rpx; border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 14rpx 34rpx rgba(52, 122, 240, 0.42), inset 0 2rpx 1rpx rgba(255, 255, 255, 0.7), inset 0 -2rpx 1rpx rgba(20, 30, 70, 0.18);
  display: inline-flex; align-items: center; justify-content: center; overflow: hidden;
}
.rx-btn-primary::before {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0) 42%);
}
.rx-btn-primary::after { border: none; }

/* 次按钮：薄白玻璃 + 脆边 + 顶亮底暗 + 上下 rim 光 */
.rx-btn-secondary {
  position: relative;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(14px) saturate(180%); backdrop-filter: blur(14px) saturate(180%);
  color: #2a44c1; border-radius: 999rpx; font-size: 28rpx; font-weight: 600;
  padding: 18rpx 40rpx; border: 1rpx solid var(--glass-border-bright);
  box-shadow: var(--glass-shadow), var(--glass-thickness); overflow: hidden;
}
.rx-btn-secondary::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(120% 120% at 50% 0%, rgba(255, 255, 255, 0.22), transparent 42%),
    radial-gradient(120% 120% at 50% 100%, rgba(255, 255, 255, 0.12), transparent 42%);
  box-shadow: var(--glass-edge);
}

/* 玻璃芯片 */
.rx-chip {
  display: inline-flex; align-items: center; position: relative;
  padding: 16rpx 32rpx; border-radius: 999rpx;
  background: var(--glass-sheen), var(--glass-bg);
  -webkit-backdrop-filter: blur(14px) saturate(190%); backdrop-filter: blur(14px) saturate(190%);
  border: 1rpx solid var(--glass-border); color: #4f5f7a; font-size: 28rpx;
  box-shadow: var(--glass-thickness); margin-right: 16rpx; margin-bottom: 16rpx; overflow: hidden;
}
.rx-chip::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(120% 120% at 50% 0%, rgba(255, 255, 255, 0.22), transparent 42%),
    radial-gradient(120% 120% at 50% 100%, rgba(255, 255, 255, 0.12), transparent 42%);
  box-shadow: var(--glass-edge);
}
.rx-chip.active {
  background: var(--brand-grad); color: #fff; border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(101, 124, 253, 0.42), inset 0 2rpx 1rpx rgba(255, 255, 255, 0.6), inset 0 -2rpx 1rpx rgba(20, 30, 70, 0.20);
}

/* 小标签 */
.rx-tag {
  display: inline-flex; align-items: center; padding: 6rpx 16rpx; border-radius: 999rpx;
  background: rgba(52, 122, 240, 0.16); color: #2a44c1; font-size: 22rpx;
}

/* 深蓝品牌玻璃（hero / 深色卡）：薄透深蓝 + 脆边 + 折射环 + 上下 rim 光 */
.glass-hero {
  position: relative;
  background: linear-gradient(90deg, rgba(8, 45, 109, .56), rgba(10, 50, 119, .48), rgba(24, 73, 136, .56));
  -webkit-backdrop-filter: blur(24px) saturate(180%) brightness(110%); backdrop-filter: blur(24px) saturate(180%) brightness(110%);
  border-radius: 31rpx; border: 1rpx solid rgba(255, 255, 255, 0.42);
  box-shadow: 0 20rpx 60rpx rgba(8, 30, 80, 0.34), inset 0 2rpx 1rpx rgba(255, 255, 255, 0.5), inset 0 -2rpx 1rpx rgba(0, 10, 40, 0.30);
  overflow: hidden;
}
.glass-hero::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(120% 120% at 50% 0%, rgba(255, 255, 255, 0.20), transparent 42%),
    radial-gradient(120% 120% at 50% 100%, rgba(255, 255, 255, 0.10), transparent 42%);
  box-shadow: var(--glass-edge);
}

/* 浅色品牌玻璃（淡蓝/淡紫信息块） */
.glass-tint {
  position: relative;
  background: var(--glass-sheen), var(--glass-bg-tint);
  -webkit-backdrop-filter: blur(20px) saturate(200%); backdrop-filter: blur(20px) saturate(200%);
  border: 1rpx solid var(--glass-border); border-radius: 28rpx;
  box-shadow: var(--glass-shadow), var(--glass-thickness); overflow: hidden;
}
.glass-tint::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(120% 120% at 50% 0%, rgba(255, 255, 255, 0.22), transparent 42%),
    radial-gradient(120% 120% at 50% 100%, rgba(255, 255, 255, 0.12), transparent 42%);
  box-shadow: var(--glass-edge);
}

/* 白玻璃按钮（浅底上的次按钮 / 关闭） */
.glass-btn-light {
  position: relative;
  background: var(--glass-sheen), var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(14px) saturate(180%); backdrop-filter: blur(14px) saturate(180%);
  border: 1rpx solid var(--glass-border-bright); border-radius: 999rpx; color: #2a44c1;
  box-shadow: var(--glass-shadow), var(--glass-thickness); overflow: hidden;
}
.glass-btn-light::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(120% 120% at 50% 0%, rgba(255, 255, 255, 0.22), transparent 42%),
    radial-gradient(120% 120% at 50% 100%, rgba(255, 255, 255, 0.12), transparent 42%);
  box-shadow: var(--glass-edge);
}

/* A 风格装饰星 */
.rx-spark { color: #6e6deb; font-family: Arial; }
