/* 全局主题：染心 · 蓝紫水彩（对齐 A 设计稿） */
page {
  background: linear-gradient(180deg, #fbfaf8 0%, #faf9f6 76%, #f8f7f4 100%);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #173d79;
  -webkit-font-smoothing: antialiased;
}

/* 对齐 A 首页 .page：暖白纸感 + 网点纹理 + 水彩晕染 + 气泡光点 */
.rx-bg {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: -1;
  background:
    radial-gradient(circle at 2px 2px, rgba(45,82,136,.16) 0 .6px, transparent .8px) 0 0 / 21px 21px,
    radial-gradient(ellipse 380rpx 320rpx at 82% 10%, rgba(145,185,240,.34), transparent 62%),
    radial-gradient(ellipse 300rpx 260rpx at 92% 24%, rgba(133,176,234,.28), transparent 58%),
    radial-gradient(ellipse 240rpx 200rpx at 74% 6%, rgba(162,193,242,.22), transparent 60%),
    radial-gradient(circle 130rpx at 28% 22%, rgba(170,147,239,.20), transparent 70%),
    radial-gradient(circle 64rpx at 60% 38%, rgba(119,161,221,.16), transparent 70%),
    radial-gradient(circle 40rpx at 40% 60%, rgba(168,197,237,.14), transparent 70%),
    linear-gradient(180deg, #fbfaf8 0%, #faf9f6 76%, #f8f7f4 100%);
}

/* 通用容器 */
.rx-page {
  padding: 0 32rpx 140rpx;
  box-sizing: border-box;
}

/* 通用玻璃卡片 */
.rx-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(25, 49, 88, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  overflow: hidden;
}

/* 标题字体（宋体，对齐 A） */
.rx-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #173d79;
  letter-spacing: 4rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

.rx-section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #173d79;
  margin-bottom: 20rpx;
}

/* 主按钮：渐变蓝紫（对齐 A: #347af0→#5d78fd→#a160ef） */
.rx-btn-primary {
  background: linear-gradient(90deg, #347af0 0%, #5d78fd 42%, #a160ef 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  box-shadow: 0 10rpx 24rpx rgba(101, 124, 253, 0.28);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.rx-btn-primary::after { border: none; }

/* 次按钮：白底蓝边 */
.rx-btn-secondary {
  background: rgba(255, 255, 255, 0.92);
  color: #2a44c1;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 40rpx;
  border: 1rpx solid rgba(52, 122, 240, 0.22);
}

.rx-btn-secondary::after { border: none; }

/* 标签芯片 */
.rx-chip {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(52, 122, 240, 0.16);
  color: #62749b;
  font-size: 28rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.rx-chip.active {
  background: linear-gradient(90deg, #347af0 0%, #5d78fd 42%, #a160ef 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(101, 124, 253, 0.22);
}

/* 小标签 */
.rx-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(52, 122, 240, 0.10);
  color: #2a44c1;
  font-size: 22rpx;
}

/* A 风格装饰星 */
.rx-spark { color: #6e6deb; font-family: Arial; }
