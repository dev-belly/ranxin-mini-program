/* 全局主题：染心 · 蓝紫水彩（对齐 A 设计稿） */
page {
  background: #edf1f6;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #173d79;
  -webkit-font-smoothing: antialiased;
}

/* 模拟水彩晕染背景（对齐 A：#edf1f6 + 柔光径向洗） */
.rx-bg {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: -1;
  background:
    radial-gradient(520rpx 330rpx at 16% 8%, rgba(255,255,255,.99), rgba(255,255,255,.92) 60%, transparent 100%),
    radial-gradient(ellipse at 77% 17%, rgba(145,185,240,.40), transparent 34%),
    radial-gradient(540rpx 420rpx at 74% 20%, rgba(160,194,242,.34), transparent 72%),
    radial-gradient(210rpx 170rpx at 88% 12%, rgba(184,211,244,.34), transparent 72%),
    radial-gradient(circle at 50% 45%, #fafbfe 0%, #eff3f8 68%, #e9edf4 100%);
}

/* 通用容器 */
.rx-page {
  padding: 0 32rpx 140rpx;
  box-sizing: border-box;
}

/* 通用玻璃卡片 */
.rx-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(25, 49, 88, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  overflow: hidden;
}

/* 标题字体（宋体，对齐 A） */
.rx-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #173d79;
  letter-spacing: 4rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

.rx-section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #173d79;
  margin-bottom: 20rpx;
}

/* 主按钮：渐变蓝紫（对齐 A: #347af0→#5d78fd→#a160ef） */
.rx-btn-primary {
  background: linear-gradient(90deg, #347af0 0%, #5d78fd 42%, #a160ef 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  box-shadow: 0 10rpx 24rpx rgba(93, 95, 220, 0.28);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.rx-btn-primary::after { border: none; }

/* 次按钮：白底蓝边 */
.rx-btn-secondary {
  background: rgba(255, 255, 255, 0.92);
  color: #3a55c8;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 40rpx;
  border: 1rpx solid rgba(75, 110, 230, 0.22);
}

.rx-btn-secondary::after { border: none; }

/* 标签芯片 */
.rx-chip {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(75, 110, 230, 0.16);
  color: #62749b;
  font-size: 28rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.rx-chip.active {
  background: linear-gradient(90deg, #347af0 0%, #5d78fd 42%, #a160ef 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(93, 95, 220, 0.22);
}

/* 小标签 */
.rx-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(75, 110, 230, 0.10);
  color: #3a55c8;
  font-size: 22rpx;
}

/* A 风格装饰星 */
.rx-spark { color: #6e6deb; font-family: Arial; }
