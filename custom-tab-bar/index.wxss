/* 自定义玻璃 tabBar：仿苹果 App Store 液态玻璃胶囊
   毛玻璃大圆角容器 + 脆边高光 + 选中项白色胶囊高亮 + 图标
   这里故意用普通 view 而不是 cover-view：
     - tabBar 所在三个页面都没有 video / map 等需要被覆盖的原生组件；
     - cover-view 与页面里普通 view 不在同一层叠上下文，iOS 端会出现下方
       文字穿透 tab bar 导致显示异常；
     - 改回 view 之后，z-index:999 才能稳定压住页面所有内容。 */

.tabbar {
  position: fixed;
  left: 4%;
  right: 4%;
  bottom: 22rpx;
  display: flex;
  align-items: center;
  padding: 10rpx 12rpx;
  background: rgba(255, 255, 255, .72);
  -webkit-backdrop-filter: blur(22rpx) saturate(180%);
  backdrop-filter: blur(22rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, .86);
  border-radius: 48rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 42rpx rgba(18, 28, 64, .16), inset 0 2rpx 1rpx rgba(255, 255, 255, .92), inset 0 -2rpx 2rpx rgba(18, 28, 64, .06);
  /* 关键：覆盖整个页面所有内容，包括 absolute 定位的文字 */
  z-index: 9999;
}
.tab {
  flex: 1;
  height: 102rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  overflow: hidden;
  position: relative;
}
.tab.on {
  background: rgba(255, 255, 255, .58);
  box-shadow: 0 0 28rpx rgba(86, 99, 241, .16), inset 0 2rpx 1rpx rgba(255, 255, 255, .95), inset 0 -2rpx 2rpx rgba(18, 28, 64, .06);
}
.ic {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  color: #7b8498;
  box-sizing: border-box;
}
.tab.on .ic { color: #334fc2; }
.icon-dye {
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.icon-core {
  font-size: 25rpx;
  line-height: 44rpx;
  text-align: center;
  color: currentColor;
}
.icon-vessel {
  width: 42rpx;
  height: 38rpx;
  margin-top: 8rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx 8rpx 14rpx 14rpx;
}
.vessel-neck {
  position: absolute;
  width: 22rpx;
  height: 9rpx;
  left: 7rpx;
  top: -10rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 6rpx 6rpx 0 0;
}
.vessel-star { font-size: 18rpx; line-height: 34rpx; text-align: center; }
.icon-frame {
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
}
.frame-sun {
  position: absolute;
  width: 8rpx; height: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  right: 7rpx; top: 7rpx;
}
.frame-mountain {
  position: absolute;
  left: 8rpx; right: 8rpx; bottom: 8rpx;
  height: 16rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: skew(-28deg);
}
.t {
  font-size: 24rpx;
  color: #8a93a6;
  font-weight: 500;
  margin-top: 6rpx;
}
.tab.on .t {
  color: #2a44c1;
  font-weight: 700;
}
