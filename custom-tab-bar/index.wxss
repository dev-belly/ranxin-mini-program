/* 自定义玻璃 tabBar：仿苹果 App Store 液态玻璃胶囊
   毛玻璃大圆角容器 + 脆边高光 + 选中项白色胶囊高亮 + 图标 */

.tabbar {
  position: fixed;
  left: 4%;
  right: 4%;
  bottom: 32rpx;
  display: flex;
  align-items: center;
  padding: 12rpx;
  background: rgba(255, 255, 255, .35);
  border: 1rpx solid rgba(255, 255, 255, .60);
  border-radius: 48rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 50rpx rgba(18, 28, 64, .30), inset 0 2rpx 1rpx rgba(255, 255, 255, .80), inset 0 -2rpx 2rpx rgba(18, 28, 64, .08);
  z-index: 999;
}
.tab {
  flex: 1;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
}
.tab.on {
  background: rgba(255, 255, 255, .62);
  box-shadow: inset 0 2rpx 1rpx rgba(255, 255, 255, .95), inset 0 -2rpx 2rpx rgba(18, 28, 64, .08);
}
.ic {
  font-size: 40rpx;
  line-height: 1;
}
.t {
  font-size: 24rpx;
  color: #8a93a6;
  font-weight: 500;
  margin-top: 6rpx;
}
.tab.on .t {
  color: #2a44c1;
  font-weight: 700;
}